function withCorsHeaders(resp) {
  const h = new Headers(resp.headers);
  for (const [k, v] of Object.entries(CORS_HEADERS)) h.set(k, v);
  return new Response(resp.body, { status: resp.status, headers: h });
}

export default {
  async fetch(request, env, ctx) {
    try {
      const url = new URL(request.url);
      const path = url.pathname;

      // CORS preflight
      if (request.method === "OPTIONS") {
        return new Response(null, { status: 204, headers: { ...CORS_HEADERS } });
      }

      if (path === "/diag") {
        const hasKV = !!env?.LYRICS_KV;
        return ok({
          service: "listening-mirror-lyrics",
          hasKV,
          now: new Date().toISOString(),
          routes: ["/diag", "/lyrics?artist=&track=&album=&duration="],
        });
      }

      if (path === "/lyrics") {
        if (request.method !== "GET") {
          return badRequest("method_not_allowed");
        }

        const artist = safeTrim(url.searchParams.get("artist"));
        const track = safeTrim(url.searchParams.get("track"));
        const album = safeTrim(url.searchParams.get("album"));
        const durationMs = parseIntMaybe(url.searchParams.get("duration"));

        if (!artist || !track) {
          return badRequest("missing_params", {
            need: ["artist", "track"],
            got: { artist: !!artist, track: !!track },
          });
        }

        const out = await getLyricsCore(
          {
            artist,
            track,
            album: album || undefined,
            durationMs: durationMs != null ? durationMs : undefined,
          },
          env
        );

        // Don’t leak huge payloads? We already return the lyrics if present,
        // which is the point. The UI can show it.
        return ok(out);
      }

      return json({ ok: false, error: "not_found", path }, 404);
    } catch (err) {
      return json(
        {
          ok: false,
          error: "internal_error",
          message: err?.message || String(err),
        },
        500
      );
    }
  },
};