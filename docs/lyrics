async function getLyricsCore({ artist, track, album, durationMs }, env) {
  const reqArtist = normalizeArtistName(artist);
  const reqTrack = normalizeTrackTitle(track);
  const reqAlbum = normalizeSpaces(album || "");
  const reqDurationMs = durationMs ?? null;

  if (!reqArtist || !reqTrack) {
    return { found: false, reason: "missing_artist_or_track" };
  }

  const cacheKey = makeKey(reqArtist, reqTrack, reqAlbum);

  // KV cache (store the final response object)
  if (env?.LYRICS_KV) {
    const cached = await env.LYRICS_KV.get(cacheKey, "json");
    if (cached && cached.found != null) {
      return { ...cached, cached: true };
    }
  }

  // 1) search
  const search = await lrclibSearch({
    artist: reqArtist,
    track: reqTrack,
    album: reqAlbum || undefined,
    durationMs: reqDurationMs || undefined,
  });

  if (!search.ok) {
    return {
      found: false,
      reason: "lrclib_search_failed",
      status: search.status,
    };
  }

  if (!search.list.length) {
    const out = {
      found: false,
      reason: "no_results",
      artist: reqArtist,
      track: reqTrack,
      album: reqAlbum || undefined,
      source: "lrclib",
    };
    if (env?.LYRICS_KV) {
      // cache misses briefly to reduce spam
      await env.LYRICS_KV.put(cacheKey, JSON.stringify(out), {
        expirationTtl: 6 * 60 * 60, // 6 hours for misses
      });
    }
    return out;
  }

  // 2) choose best candidate
  let best = null;
  let bestScore = -1;

  for (const cand of search.list) {
    const score = scoreCandidate({
      reqArtist,
      reqTrack,
      reqAlbum,
      reqDurationMs,
      cand,
    });
    if (score > bestScore) {
      bestScore = score;
      best = cand;
    }
  }

  const bestId = best?.id ?? best?.trackId ?? best?.track_id ?? null;

  // 3) if we have an id, use /get/{id} for full payload
  let item = best;
  let getUrl = null;

  if (bestId != null) {
    const got = await lrclibGetById(bestId);
    if (got.ok && got.item) {
      item = got.item;
      getUrl = got.url;
    }
  }

  const synced = (item.syncedLyrics || item.synced_lyrics || "").toString().trim();
  const plain = (item.plainLyrics || item.plain_lyrics || "").toString().trim();

  const lrc = synced || "";
  const lines = lrc ? parseLRC(lrc) : [];

  const out = {
    found: !!(synced || plain),
    artist: normalizeArtistName(item.artistName || item.artist_name || reqArtist),
    track: normalizeTrackTitle(item.trackName || item.track_name || reqTrack),
    album: normalizeSpaces(item.albumName || item.album_name || reqAlbum) || undefined,
    id: item.id ?? bestId ?? undefined,
    source: "lrclib",
    synced: !!synced,
    lrc: synced || null,
    lines: synced ? lines : [],
    plain: plain || null,

    // debug-ish helpful fields (harmless)
    matchScore: bestScore,
    cached: false,
    provider: {
      searchCount: search.list.length,
      gotById: !!getUrl,
    },
  };

  if (env?.LYRICS_KV) {
    // Cache hits for 30 days
    await env.LYRICS_KV.put(cacheKey, JSON.stringify(out), {
      expirationTtl: 30 * 24 * 60 * 60,
    });
  }

  return out;
}
