/* lyrics.js (FULL FILE REPLACE) — PART 1/4 ✅
   Listening Mirror — Lyrics Microservice
   ✅ Routes:
      - GET  /diag
      - GET  /lyrics?artist=&track=&album=&duration=
   ✅ Provider: LRCLIB (search -> get)
   ✅ Prefers SYNCED LRC + also returns parsed lines[]
   ✅ KV caching (LYRICS_KV)
*/

const CORS_HEADERS = {
  "access-control-allow-origin": "*",
  "access-control-allow-methods": "GET,POST,OPTIONS",
  "access-control-allow-headers": "content-type,authorization",
  "access-control-max-age": "86400",
};

const JSON_HEADERS = {
  "content-type": "application/json; charset=utf-8",
};

function json(res, status = 200, extraHeaders = {}) {
  return new Response(JSON.stringify(res, null, 2), {
    status,
    headers: { ...JSON_HEADERS, ...CORS_HEADERS, ...extraHeaders },
  });
}

function badRequest(msg, extra = {}) {
  return json({ ok: false, error: msg, ...extra }, 400);
}

function ok(res) {
  return json({ ok: true, ...res }, 200);
}

function clamp(n, a, b) {
  return Math.max(a, Math.min(b, n));
}

function safeTrim(s) {
  return (s ?? "").toString().trim();
}

function normalizeSpaces(s) {
  return safeTrim(s).replace(/\s+/g, " ");
}

// Aggressive cleanup for Last.fm-ish titles:
// - remove "(feat ...)" / "[feat ...]" / "ft."
// - remove "(remaster...)" / "(live ...)" / "(radio edit)" etc.
// - remove trailing "- remaster" / "- live" / "- edit" segments
// Keep it conservative enough to not destroy actual titles.
function normalizeTrackTitle(input) {
  let s = normalizeSpaces(input);

  // Replace fancy quotes/dashes
  s = s.replace(/[’‘]/g, "'").replace(/[–—]/g, "-");

  // Remove common "feat" patterns (parentheses or brackets)
  s = s.replace(/\s*[\(\[\{]\s*(feat\.?|ft\.?)\s+[^)\]\}]+[\)\]\}]\s*/gi, " ");
  s = s.replace(/\s+(feat\.?|ft\.?)\s+.+$/i, " "); // if it's appended without parentheses

  // Remove bracketed qualifiers often unrelated to title matching
  s = s.replace(/\s*[\(\[]\s*(remaster(ed)?|mono|stereo|live|radio edit|edit|version|mix|demo|bonus track|deluxe|expanded|anniversary|reissue|single|explicit|clean|acoustic|instrumental|ost|soundtrack)\b[^)\]]*[\)\]]\s*/gi, " ");

  // Remove trailing dash qualifiers
  s = s.replace(/\s*-\s*(remaster(ed)?|live|radio edit|edit|version|mix|demo|bonus track|deluxe|expanded|anniversary|reissue|single)\b.*$/i, " ");

  // Cleanup leftover punctuation & spaces
  s = normalizeSpaces(s);
  s = s.replace(/\s*\/\s*/g, " / ");
  return s;
}

function normalizeArtistName(input) {
  let s = normalizeSpaces(input);
  s = s.replace(/[’‘]/g, "'").replace(/[–—]/g, "-");
  // "Artist & Artist" / "Artist x Artist" variants are kept (can matter)
  return s;
}

function makeKey(artist, track, album) {
  const a = normalizeArtistName(artist).toLowerCase();
  const t = normalizeTrackTitle(track).toLowerCase();
  const al = normalizeSpaces(album || "").toLowerCase();
  return `v1:${a}::${t}::${al}`;
}

function parseIntMaybe(v) {
  const n = Number(v);
  return Number.isFinite(n) ? n : null;
}

function parseLRC(lrcText) {
  const lrc = (lrcText ?? "").toString();
  const lines = [];
  // Supports multiple timestamps per line: [mm:ss.xx][mm:ss.xx]text
  const re = /\[(\d{1,2}):(\d{2})(?:\.(\d{1,3}))?\]/g;

  for (const rawLine of lrc.split(/\r?\n/)) {
    const line = rawLine.trimEnd();
    if (!line) continue;

    let match;
    const stamps = [];
    while ((match = re.exec(line)) !== null) {
      const mm = Number(match[1]);
      const ss = Number(match[2]);
      const frac = match[3] ? match[3].padEnd(3, "0") : "000";
      const ms = Number(frac);
      if (Number.isFinite(mm) && Number.isFinite(ss) && Number.isFinite(ms)) {
        stamps.push((mm * 60 + ss) * 1000 + ms);
      }
    }

    // remove all timestamps to get text
    const text = line.replace(re, "").trim();
    if (!stamps.length) continue;

    for (const timeMs of stamps) {
      lines.push({ timeMs, text });
    }
  }

  // Sort by time, stable-ish
  lines.sort((a, b) => a.timeMs - b.timeMs);
  return lines;
}
