/* live.js (FULL REPLACE)
   Cloudflare Worker: /econcerts endpoint
   Sources:
   - Ticketmaster (tm)
   - MetalAgenda.nl venues (ma)
   Env vars:
   - TMASTER_API_KEY
   - LASTFM_API_KEY
   - LASTFM_USER
*/

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // --- CORS (GitHub Pages + optional localhost) ---
    const origin = request.headers.get("Origin") || "";
    const allowed = new Set([
      "https://mr-tanq.github.io",
      "http://localhost:5173",
      "http://localhost:4173",
      "http://localhost:3000",
    ]);
    const allowOrigin = allowed.has(origin) ? origin : "https://mr-tanq.github.io";

    const corsHeaders = {
      "access-control-allow-origin": allowOrigin,
      "access-control-allow-methods": "GET,POST,OPTIONS",
      "access-control-allow-headers": "content-type, authorization",
      "access-control-max-age": "86400",
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { status: 204, headers: corsHeaders });
    }

    const jsonRes = (obj, status = 200) =>
      new Response(JSON.stringify(obj, null, 2), {
        status,
        headers: {
          "content-type": "application/json; charset=utf-8",
          ...corsHeaders,
        },
      });

    const lowerKey = (s) => String(s || "").trim().toLowerCase();
    const clamp01 = (x) => Math.max(0, Math.min(1, x));
    const clampInt = (v, a, b, fallback) => {
      const n = Number(v);
      if (!Number.isFinite(n)) return fallback;
      return Math.max(a, Math.min(b, Math.trunc(n)));
    };

    try {
      if (url.pathname === "/health") {
        return jsonRes({ ok: true, service: "live", time: new Date().toISOString() });
      }

      if (url.pathname === "/econcerts") {
        return await handleEconcerts(request, env, ctx, jsonRes, lowerKey, clamp01, clampInt);
      }

      return jsonRes({ ok: false, error: "not_found", path: url.pathname }, 404);
    } catch (err) {
      return jsonRes(
        {
          ok: false,
          error: "internal_error",
          message: String(err && err.message ? err.message : err),
        },
        500
      );
    }
  },
};

async function handleEconcerts(request, env, ctx, jsonRes, lowerKey, clamp01, clampInt) {
  const url = new URL(request.url);

  const TMASTER_API_KEY = String(env.TMASTER_API_KEY || "").trim();
  const LASTFM_API_KEY = String(env.LASTFM_API_KEY || "").trim();
  const LASTFM_USER = String(env.LASTFM_USER || "").trim();

  const size = clampInt(url.searchParams.get("size"), 1, 1000, 50);
  const radiusKm = clampInt(url.searchParams.get("radiusKm"), 1, 500, 30);
  const scoreMin = clampInt(url.searchParams.get("scoreMin"), 0, 100, 50);
  const tasteArtists = clampInt(url.searchParams.get("tasteArtists"), 10, 2000, 200);

  const cityRaw = String(url.searchParams.get("city") || "").trim();
  const city = cityRaw;
  const countryCode = String(url.searchParams.get("countryCode") || "NL").trim().toUpperCase();

  const sources = parseSources(String(url.searchParams.get("sources") || "tm"));

  if (!LASTFM_API_KEY) return jsonRes({ ok: false, error: "missing_env", message: "Missing LASTFM_API_KEY" }, 500);
  if (!LASTFM_USER) return jsonRes({ ok: false, error: "missing_env", message: "Missing LASTFM_USER" }, 500);

  if (sources.includes("tm") && !TMASTER_API_KEY) {
    return jsonRes({ ok: false, error: "missing_env", message: "Missing TMASTER_API_KEY" }, 500);
  }

  const taste = await lastfmTopArtistsOverall(LASTFM_API_KEY, LASTFM_USER, tasteArtists);
  const tasteMap = new Map(taste.map((x) => [lowerKey(x.name), x.playcount]));

  const collected = [];

  if (sources.includes("tm")) {
    const tmEvents = await ticketmasterEvents({
      apiKey: TMASTER_API_KEY,
      countryCode,
      city: city || "",
      radiusKm: city ? radiusKm : null,
      sizeRequested: size,
    });
    for (const ev of tmEvents) collected.push({ ...ev, source: "tm" });
  }

  let maPagesFetched = 0;
  let maEventsParsed = 0;
  if (sources.includes("ma")) {
    const maRes = await metalAgendaEvents({
      maxEvents: size,
      countryCode,
    });
    maPagesFetched = maRes.pagesFetched;
    maEventsParsed = maRes.eventsParsed;
    for (const ev of maRes.events) collected.push({ ...ev, source: "ma" });
  }

  const deduped = dedupeCollected(collected, lowerKey);

  const eventsScored = [];
  for (const ev of deduped) {
    const artist = ev.artist || "";
    const plays = tasteMap.get(lowerKey(artist)) || 0;

    const tier = tierFromPlays(plays);
    const base = baseScoreFromTier(tier);

    const daysAway = Math.max(0, Math.round((ev.startTs - Date.now()) / (24 * 60 * 60 * 1000)));
    const proximityBoost = clamp01(1 - daysAway / 365);
    let score = base + Math.round(proximityBoost * 18);

    if (lowerKey(ev.city) === "utrecht") score += 4;
    if (plays === 0) score = Math.min(score, 49);

    score = Math.max(0, Math.min(100, Math.round(score)));
    const level = score >= 80 ? "strong" : score >= 65 ? "good" : score >= 50 ? "ok" : "weak";

    const venueLower = lowerKey(ev.venue || "");
    const star = venueLower.includes("tivoli") && plays >= 100;

    const out = {
      id: ev.id,
      artist: artist,
      attractions: ev.attractions,
      city: ev.city,
      venue: ev.venue,
      start: ev.startLocal,
      url: ev.url,
      plays,
      tier,
      score,
      level,
      startTs: ev.startTs,
      source: ev.source || "tm",
      star,
    };

    if (score >= scoreMin) eventsScored.push(out);
  }

  eventsScored.sort((a, b) => (b.score - a.score) || (a.startTs - b.startTs));
  const finalEvents = eventsScored.slice(0, size);

  return jsonRes({
    ok: true,
    meta: {
      sizeRequested: size,
      radiusKm: city ? radiusKm : null,
      scoreMin,
      tasteArtists,
      eventsFetched: deduped.length,
      eventsReturned: finalEvents.length,
      city: city || null,
      countryCode,
      sources,
      mode: city ? "near_city" : "nl_wide",
      maPagesFetched: sources.includes("ma") ? maPagesFetched : null,
      maEventsParsed: sources.includes("ma") ? maEventsParsed : null,
    },
    events: finalEvents,
  });
}

function parseSources(raw) {
  const s = String(raw || "tm")
    .split(",")
    .map((x) => x.trim().toLowerCase())
    .filter(Boolean);

  const out = [];
  for (const x of s) {
    if (x === "tm" || x === "ticketmaster") out.push("tm");
    if (x === "ma" || x === "metalagenda") out.push("ma");
  }
  return out.length ? Array.from(new Set(out)) : ["tm"];
}
// ---------------- Last.fm ----------------
async function lastfmTopArtistsOverall(apiKey, user, limit) {
  const u = new URL("https://ws.audioscrobbler.com/2.0/");
  u.searchParams.set("method", "user.gettopartists");
  u.searchParams.set("user", user);
  u.searchParams.set("api_key", apiKey);
  u.searchParams.set("format", "json");
  u.searchParams.set("limit", String(limit));
  u.searchParams.set("period", "overall");

  const r = await fetch(u.toString(), { method: "GET" });
  const j = await r.json().catch(() => ({}));

  if (!r.ok) throw new Error(`Last.fm HTTP ${r.status}`);
  if (j && j.error) throw new Error(`Last.fm: ${j.message || "error"}`);

  const arr = j?.topartists?.artist;
  if (!Array.isArray(arr)) return [];

  const out = [];
  for (const a of arr) {
    const name = String(a?.name || "").trim();
    const playcount = Number(a?.playcount || 0);
    if (!name) continue;
    out.push({ name, playcount: Number.isFinite(playcount) ? playcount : 0 });
  }
  return out;
}

// ---------------- Ticketmaster ----------------
async function ticketmasterEvents({ apiKey, countryCode, city, radiusKm, sizeRequested }) {
  const want = Math.max(1, Math.min(1000, Number(sizeRequested) || 1));
  const pageSize = Math.min(200, want);
  const nowIso = new Date().toISOString().replace(/\.\d{3}Z$/, "Z");

  const out = [];
  let page = 0;
  const maxPages = Math.min(10, Math.ceil(want / pageSize) + 2);

  while (out.length < want && page < maxPages) {
    const u = new URL("https://app.ticketmaster.com/discovery/v2/events.json");
    u.searchParams.set("apikey", apiKey);
    u.searchParams.set("countryCode", countryCode);
    u.searchParams.set("classificationName", "music");
    u.searchParams.set("sort", "date,asc");
    u.searchParams.set("size", String(pageSize));
    u.searchParams.set("page", String(page));
    u.searchParams.set("startDateTime", nowIso);

    const cityTrim = String(city || "").trim();
    if (cityTrim) {
      u.searchParams.set("city", cityTrim);
      if (radiusKm != null) {
        u.searchParams.set("radius", String(radiusKm));
        u.searchParams.set("unit", "km");
      }
    }

    const r = await fetch(u.toString(), { method: "GET" });
    const j = await r.json().catch(() => ({}));

    if (!r.ok) {
      const msg = j?.errors?.[0]?.detail || `Ticketmaster HTTP ${r.status}`;
      throw new Error(msg);
    }

    const items = j?._embedded?.events;
    if (!Array.isArray(items) || items.length === 0) break;

    for (const e of items) {
      if (out.length >= want) break;

      const id = String(e?.id || "").trim();
      if (!id) continue;

      const attractions = Array.isArray(e?._embedded?.attractions)
        ? e._embedded.attractions.map((a) => String(a?.name || "").trim()).filter(Boolean)
        : [];

      const artist = attractions[0] || String(e?.name || "").trim();

      const venueObj = Array.isArray(e?._embedded?.venues) ? e._embedded.venues[0] : null;
      const venue = String(venueObj?.name || "").trim();

      const cityName = String(venueObj?.city?.name || "").trim() || cityTrim || "";

      const dt = String(e?.dates?.start?.dateTime || "").trim();
      if (!dt) continue;

      const startDate = new Date(dt);
      if (Number.isNaN(startDate.getTime())) continue;

      const startTs = startDate.getTime();
      const startLocal = formatAmsterdamLocal(startDate);
      const url = String(e?.url || "").trim();

      out.push({
        id: `tm:${id}`,
        artist,
        attractions,
        city: cityName,
        venue: venue || "",
        startTs,
        startLocal,
        url,
      });
    }

    page += 1;
    const pageInfo = j?.page;
    if (pageInfo && Number.isFinite(pageInfo.totalPages) && page >= pageInfo.totalPages) break;
  }

  return out;
}

// ---------------- MetalAgenda (venues) ----------------
async function metalAgendaEvents({ maxEvents, countryCode }) {
  if (String(countryCode || "").toUpperCase() !== "NL") {
    return { pagesFetched: 0, eventsParsed: 0, events: [] };
  }

  const want = Math.max(1, Math.min(1000, Number(maxEvents) || 50));
  const venueUrls = [
    "https://www.metalagenda.nl/venues/tivoli-vredenburg",
    "https://www.metalagenda.nl/venues/db-s",
    "https://www.metalagenda.nl/venues/de-helling",
    "https://www.metalagenda.nl/venues/melkweg",
    "https://www.metalagenda.nl/venues/paradiso",
    "https://www.metalagenda.nl/venues/baroeg",
    "https://www.metalagenda.nl/venues/013",
    "https://www.metalagenda.nl/venues/dynamo",
    "https://www.metalagenda.nl/venues/doornroosje",
    "https://www.metalagenda.nl/venues/paard",
    "https://www.metalagenda.nl/venues/patronaat",
    "https://www.metalagenda.nl/venues/metropool",
  ];

  const events = [];
  let pagesFetched = 0;
  let eventsParsed = 0;

  const concurrency = 4;
  let idx = 0;

  const runner = async () => {
    while (idx < venueUrls.length && events.length < want) {
      const i = idx++;
      const vurl = venueUrls[i];

      const html = await fetchText(vurl).catch(() => "");
      pagesFetched += 1;
      if (!html) continue;

      const parsed = parseMetalAgendaVenueHtml(vurl, html);
      eventsParsed += parsed.length;

      for (const ev of parsed) {
        if (events.length >= want) break;
        events.push(ev);
      }
    }
  };

  await Promise.all(Array.from({ length: concurrency }, () => runner()));

  const cutoff = Date.now() - 12 * 60 * 60 * 1000;
  const upcoming = events.filter((e) => Number(e?.startTs) >= cutoff);
  upcoming.sort((a, b) => (a.startTs - b.startTs));

  return {
    pagesFetched,
    eventsParsed,
    events: upcoming.slice(0, want),
  };
}

async function fetchText(u) {
  const r = await fetch(u, {
    method: "GET",
    headers: {
      "accept": "text/html,*/*",
      "user-agent": "ListeningMirror/1.0 (mr-tanq)",
    },
  });
  if (!r.ok) return "";
  return await r.text().catch(() => "");
}

function parseMetalAgendaVenueHtml(pageUrl, html) {
  const text = htmlToText(html);

  // venue + city from header
  let venue = "";
  let city = "";

  const headerMatch = text.match(/Metal concerten bij\s+(.+?)\s+te\s+(.+?)(?:\n|$)/i);
  if (headerMatch) {
    venue = cleanPlace(String(headerMatch[1] || "").trim());
    city = cleanPlace(String(headerMatch[2] || "").trim());
  }

  // Normalize spaced letters/digits + decode entities
  const normalized = decodeHtmlEntities(normalizeSpacedText(text));

  const lines = normalized
    .split("\n")
    .map((l) => l.trim())
    .filter((l) => l.length > 0);

  const monthMap = {
    januari: 0,
    februari: 1,
    maart: 2,
    april: 3,
    mei: 4,
    juni: 5,
    juli: 6,
    augustus: 7,
    september: 8,
    oktober: 9,
    november: 10,
    december: 11,
  };

  const weekdays = [
    "maandag",
    "dinsdag",
    "woensdag",
    "donderdag",
    "vrijdag",
    "zaterdag",
    "zondag",
  ];

  const out = [];

  for (const line0 of lines) {
    // must start with a date
    const m = line0.match(/^(\d{1,2})\s+([a-z]+)\s+(\d{4})\s*(.*)$/i);
    if (!m) continue;

    const day = Number(m[1]);
    const monthName = String(m[2] || "").toLowerCase();
    const year = Number(m[3]);
    const rest0 = String(m[4] || "");

    const monthIdx = monthMap[monthName];
    if (monthIdx == null) continue;

    let rest = rest0.trim();

    // strip weekday at start
    for (const wd of weekdays) {
      if (rest.toLowerCase().startsWith(wd)) {
        rest = rest.slice(wd.length).trim();
        break;
      }
    }

    // strip "uitverkocht" at start
    rest = rest.replace(/^uitverkocht\s+/i, "").trim();

    // split title vs bands
    let title = rest;
    let bandsPart = "";
    const bi = rest.toLowerCase().indexOf("bands:");
    if (bi >= 0) {
      title = rest.slice(0, bi).trim();
      bandsPart = rest.slice(bi + "bands:".length).trim();
    }

    title = title.replace(/\s+/g, " ").trim();
    bandsPart = bandsPart.replace(/\s+/g, " ").trim();

    // ignore junk
    if (!title) continue;
    if (/^bands:\s*-\s*$/i.test(line0)) continue;
    if (title.toLowerCase().startsWith("de metal concertagenda")) continue;

    let bands = [];
    if (bandsPart) {
      bands = bandsPart
        .split("|")
        .map((x) => x.trim())
        .filter((x) => x && x !== "-");
    }

    const headliner = (bands[0] || title).trim();
    if (!headliner || headliner === "-") continue;

    // Default time for MA (unknown) = 20:00 local
    let hh = 20, mm = 0;
    const tm = line0.match(/\b([01]\d|2[0-3]):([0-5]\d)\b/);
    if (tm) {
      hh = Number(tm[1]);
      mm = Number(tm[2]);
    }

    // Build a local Amsterdam datetime safely:
    // We create an ISO-like string and then convert via Intl format util
    const startDate = new Date(Date.UTC(year, monthIdx, day, hh, mm, 0));
    const startLocal = formatAmsterdamLocal(startDate);
    const startTs = Date.parse(startLocal); // local parse on frontend expectation

    const url = findFirstLinkForTitle(html, title) || pageUrl;

    const id = `ma:${slugify(venue || "venue")}:${year}-${String(monthIdx + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}:${slugify(headliner)}:${slugify(city)}`;

    out.push({
      id,
      artist: headliner,
      attractions: bands.length ? bands : [headliner],
      city: city || "",
      venue: venue || "",
      startTs: Number.isFinite(startTs) ? startTs : startDate.getTime(),
      startLocal: startLocal,
      url,
    });
  }

  return out;
}

function cleanPlace(s) {
  let x = String(s || "").trim();
  x = x.replace(/\s*De metal concertagenda.*$/i, "").trim();
  x = x.replace(/\s{2,}/g, " ").trim();
  return x;
}

function normalizeSpacedText(s) {
  let t = String(s || "");
  t = t.replace(/(\d)\s+(?=\d)/g, "$1");
  for (let i = 0; i < 5; i++) {
    t = t.replace(/([A-Za-zÀ-ÿ])\s+(?=[A-Za-zÀ-ÿ])/g, "$1");
  }
  t = t.replace(/[ \t]+/g, " ");
  return t;
}

function decodeHtmlEntities(s) {
  let t = String(s || "");

  // numeric entities
  t = t.replace(/&#(\d+);/g, (_, n) => {
    const code = Number(n);
    if (!Number.isFinite(code)) return _;
    try { return String.fromCodePoint(code); } catch { return _; }
  });

  // common named entities we actually see in MA
  const map = {
    "&eacute;": "é",
    "&Eacute;": "É",
    "&ouml;": "ö",
    "&Ouml;": "Ö",
    "&uuml;": "ü",
    "&Uuml;": "Ü",
    "&auml;": "ä",
    "&Auml;": "Ä",
    "&oslash;": "ø",
    "&Oslash;": "Ø",
    "&amp;": "&",
    "&quot;": "\"",
    "&#39;": "'",
    "&lt;": "<",
    "&gt;": ">",
    "&nbsp;": " ",
  };

  for (const [k, v] of Object.entries(map)) {
    t = t.split(k).join(v);
  }

  // cleanup any remaining &xxx;
  t = t.replace(/&[a-zA-Z]+;/g, "");
  return t;
}

function htmlToText(html) {
  let s = String(html || "");
  s = s.replace(/<br\s*\/?>/gi, "\n");
  s = s.replace(/<\/p>/gi, "\n");
  s = s.replace(/<\/h\d>/gi, "\n");
  s = s.replace(/<\/li>/gi, "\n");
  s = s.replace(/<\/div>/gi, "\n");
  s = s.replace(/<[^>]+>/g, " ");
  s = s.replace(/\r/g, "\n");
  s = s.replace(/\n{3,}/g, "\n\n");
  return s.trim();
}

function findFirstLinkForTitle(html, title) {
  const t = String(title || "").trim();
  if (!t) return "";
  const idx = String(html).toLowerCase().indexOf(t.toLowerCase());
  if (idx < 0) return "";
  const snippet = String(html).slice(idx, idx + 2000);
  const m = snippet.match(/href\s*=\s*["']([^"']+)["']/i);
  if (!m) return "";
  const href = String(m[1] || "").trim();
  if (!href) return "";
  if (href.startsWith("http")) return href;
  if (href.startsWith("/")) return "https://www.metalagenda.nl" + href;
  return href;
}

function slugify(s) {
  return String(s || "")
    .toLowerCase()
    .trim()
    .replace(/['’]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "");
}
function dedupeCollected(items, lowerKey) {
  const map = new Map();
  for (const ev of items || []) {
    const artist = lowerKey(ev?.artist || "");
    const venue = lowerKey(ev?.venue || "");
    const city = lowerKey(ev?.city || "");
    const ts = Number(ev?.startTs || 0);
    if (!artist || !ts) continue;

    const key = `${artist}|${ts}|${city}|${venue}`;
    const prev = map.get(key);
    if (!prev) {
      map.set(key, ev);
      continue;
    }

    const prevUrl = String(prev?.url || "");
    const curUrl = String(ev?.url || "");
    const prevScore = (prev?.source === "tm" ? 2 : 1) + (prevUrl.startsWith("http") ? 1 : 0);
    const curScore = (ev?.source === "tm" ? 2 : 1) + (curUrl.startsWith("http") ? 1 : 0);

    if (curScore > prevScore) map.set(key, ev);
  }
  return Array.from(map.values());
}

// ---------------- Scoring tiers ----------------
function tierFromPlays(plays) {
  const p = Number(plays || 0);
  if (p >= 120) return "core";
  if (p >= 40) return "known";
  if (p >= 10) return "maybe";
  return "discovery";
}
function baseScoreFromTier(tier) {
  if (tier === "core") return 72;
  if (tier === "known") return 58;
  if (tier === "maybe") return 45;
  return 32;
}

// ---------------- Time formatting: Europe/Amsterdam ----------------
function formatAmsterdamLocal(dateObj) {
  const parts = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Europe/Amsterdam",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  }).formatToParts(dateObj);

  const get = (type) => parts.find((p) => p.type === type)?.value || "00";
  const y = get("year");
  const m = get("month");
  const d = get("day");
  const hh = get("hour");
  const mm = get("minute");
  const ss = get("second");

  return `${y}-${m}-${d}T${hh}:${mm}:${ss}`;
}