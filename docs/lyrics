async function fetchJson(url, init = {}) {
  const res = await fetch(url, {
    ...init,
    headers: {
      "accept": "application/json",
      ...(init.headers || {}),
    },
  });
  const text = await res.text();
  let data = null;
  try {
    data = text ? JSON.parse(text) : null;
  } catch (e) {
    // non-json
  }
  return { res, data, text };
}

function scoreCandidate({
  reqArtist,
  reqTrack,
  reqAlbum,
  reqDurationMs,
  cand,
}) {
  // cand fields we might see: artistName/trackName/albumName/duration/syncedLyrics/plainLyrics/id
  const candArtist = normalizeArtistName(cand.artistName || cand.artist_name || "");
  const candTrack = normalizeTrackTitle(cand.trackName || cand.track_name || "");
  const candAlbum = normalizeSpaces(cand.albumName || cand.album_name || "");

  let score = 0;

  if (candArtist && reqArtist && candArtist.toLowerCase() === reqArtist.toLowerCase()) score += 60;
  else if (candArtist && reqArtist && candArtist.toLowerCase().includes(reqArtist.toLowerCase())) score += 30;

  if (candTrack && reqTrack && candTrack.toLowerCase() === reqTrack.toLowerCase()) score += 80;
  else if (candTrack && reqTrack && candTrack.toLowerCase().includes(reqTrack.toLowerCase())) score += 35;

  if (reqAlbum && candAlbum) {
    if (candAlbum.toLowerCase() === reqAlbum.toLowerCase()) score += 25;
    else if (candAlbum.toLowerCase().includes(reqAlbum.toLowerCase())) score += 10;
  }

  // Prefer synced if present
  const hasSynced = !!(cand.syncedLyrics || cand.synced_lyrics);
  const hasPlain = !!(cand.plainLyrics || cand.plain_lyrics);
  if (hasSynced) score += 40;
  else if (hasPlain) score += 10;

  // Duration closeness if available (LRCLIB often stores duration in seconds)
  const candDur = cand.duration ?? cand.trackDuration ?? cand.track_duration ?? null;
  if (reqDurationMs && candDur != null) {
    const candMs = candDur > 1000 ? Number(candDur) : Number(candDur) * 1000; // guess seconds if small
    if (Number.isFinite(candMs)) {
      const diff = Math.abs(reqDurationMs - candMs);
      // 0 diff => +25, 5s => +20, 15s => +10, 30s => +0
      const bonus = clamp(25 - diff / 1200, 0, 25); // 1200ms step ≈ 1.2s
      score += bonus;
    }
  }

  return score;
}

async function lrclibSearch({ artist, track, album, durationMs }) {
  const params = new URLSearchParams();
  if (artist) params.set("artist_name", artist);
  if (track) params.set("track_name", track);
  if (album) params.set("album_name", album);
  if (durationMs != null) params.set("duration", String(durationMs));

  // Some clients also pass q; we keep it minimal and explicit.
  const url = `https://lrclib.net/api/search?${params.toString()}`;
  const { res, data, text } = await fetchJson(url);

  if (!res.ok) {
    return { ok: false, status: res.status, data, text, url };
  }
  if (!Array.isArray(data)) {
    return { ok: true, list: [], url, raw: data };
  }
  return { ok: true, list: data, url };
}

async function lrclibGetById(id) {
  const url = `https://lrclib.net/api/get/${encodeURIComponent(String(id))}`;
  const { res, data, text } = await fetchJson(url);

  if (!res.ok) {
    return { ok: false, status: res.status, data, text, url };
  }
  // Expect object with syncedLyrics/plainLyrics, etc.
  return { ok: true, item: data, url };
}
