function parseReggaeAgendaHtml(html, pageUrl) {
  const out = [];

  // month abbreviations as seen on page: "20 feb", "28 feb", etc.
  const monMap = {
    jan: 0, feb: 1, mrt: 2, apr: 3, mei: 4, jun: 5, jul: 6, aug: 7, sep: 8, okt: 9, nov: 10, dec: 11,
  };

  // Try to pick year from nearby "februari 2026" headings; default current year if missing
  let yearGuess = new Date().getFullYear();
  const yearHeading = String(html).match(/\b(januari|februari|maart|april|mei|juni|juli|augustus|september|oktober|november|december)\s+(20\d{2})\b/i);
  if (yearHeading) yearGuess = Number(yearHeading[2]);

  // Regex: day + mon + time + venue line + h4/a title
  // We keep it tolerant (site structure can vary).
  const re =
    /\b(\d{1,2})\s+(jan|feb|mrt|apr|mei|jun|jul|aug|sep|okt|nov|dec)\b[\s\S]{0,160}?\b([01]\d|2[0-3]):([0-5]\d)\b[\s\S]{0,220}?\b([^\n<]{3,120}?),\s*([^\n<]{2,60})\b[\s\S]{0,500}?<a[^>]+href="([^"]+)"[^>]*>\s*([^<]{2,220})\s*<\/a>/gi;

  let m;
  while ((m = re.exec(String(html))) && out.length < 5000) {
    const day = Number(m[1]);
    const mon = String(m[2] || "").toLowerCase();
    const hh = Number(m[3]);
    const mm = Number(m[4]);

    const venueName = decodeHtmlEntities(String(m[5] || "").trim());
    const cityName = decodeHtmlEntities(String(m[6] || "").trim());

    const url = String(m[7] || "").trim();
    const title = decodeHtmlEntities(String(m[8] || "").trim()).replace(/\s+/g, " ").trim();

    const monthIdx = monMap[mon];
    if (monthIdx == null) continue;
    if (!title) continue;

    const startTs = epochFromAmsterdamLocal(yearGuess, monthIdx, day, hh, mm, 0);
    const startLocal = formatAmsterdamLocal(new Date(startTs));

    // Heuristic: artist/headline is first chunk before "|"
    const head = String(title).split("|")[0].trim();
    const artist = head || title;

    out.push({
      id: `ra:${yearGuess}-${String(monthIdx + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}:${slugify(artist)}:${slugify(cityName)}`,
      artist,
      attractions: [artist],
      city: cityName || "",
      venue: venueName || "",
      startTs,
      startLocal,
      url: url || pageUrl,
    });
  }

  // Fallback: if regex fails, do a simple lines scan (no deep link; url=pageUrl)
  if (!out.length) {
    const lines = stripHtmlToLines(html);
    // very light parser: find "20 feb" then time then "Venue, City" then title
    for (let i = 0; i < lines.length && out.length < 2000; i++) {
      const d = lines[i].match(/^(\d{1,2})\s+(jan|feb|mrt|apr|mei|jun|jul|aug|sep|okt|nov|dec)\b/i);
      if (!d) continue;

      const day = Number(d[1]);
      const mon = String(d[2] || "").toLowerCase();
      const monthIdx = monMap[mon];
      if (monthIdx == null) continue;

      const timeLine = String(lines[i + 1] || "");
      const tm = timeLine.match(/\b([01]\d|2[0-3]):([0-5]\d)\b/);
      const hh = tm ? Number(tm[1]) : 20;
      const mm = tm ? Number(tm[2]) : 0;

      const venueLine = String(lines[i + 2] || "");
      const vc = venueLine.split(",").map((x) => x.trim()).filter(Boolean);
      const venue = vc[0] || "";
      const city = vc[1] || "";

      const titleLine = String(lines[i + 3] || "");
      if (!titleLine || titleLine.length < 2) continue;

      const startTs = epochFromAmsterdamLocal(yearGuess, monthIdx, day, hh, mm, 0);
      const startLocal = formatAmsterdamLocal(new Date(startTs));

      const head = String(titleLine).split("|")[0].trim();
      const artist = head || titleLine;

      out.push({
        id: `ra:${yearGuess}-${String(monthIdx + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}:${slugify(artist)}:${slugify(city)}`,
        artist,
        attractions: [artist],
        city,
        venue,
        startTs,
        startLocal,
        url: pageUrl,
      });
    }
  }

  // unique
  const seen = new Set();
  const uniq = [];
  for (const e of out) {
    const k = `${String(e.city)}|${String(e.artist).toLowerCase()}|${Number(e.startTs)}|${String(e.url)}`;
    if (seen.has(k)) continue;
    seen.add(k);
    uniq.push(e);
  }
  return uniq;
}

// ---------------- utils ----------------
async function mapLimit(arr, limit, fn) {
  const out = new Array(arr.length);
  let i = 0;

  const workers = Array.from({ length: Math.max(1, limit) }, async () => {
    while (i < arr.length) {
      const idx = i++;
      out[idx] = await fn(arr[idx], idx);
    }
  });

  await Promise.all(workers);
  return out;
}