}

function decodeHtmlEntities(s) {
  let t = String(s || "");

  t = t.replace(/&#(\d+);/g, (_, n) => {
    const code = Number(n);
    if (!Number.isFinite(code)) return _;
    try {
      return String.fromCodePoint(code);
    } catch {
      return _;
    }
  });

  const map = {
    "&eacute;": "é",
    "&Eacute;": "É",
    "&ouml;": "ö",
    "&Ouml;": "Ö",
    "&uuml;": "ü",
    "&Uuml;": "Ü",
    "&auml;": "ä",
    "&Auml;": "Ä",
    "&oslash;": "ø",
    "&Oslash;": "Ø",
    "&amp;": "&",
    "&quot;": '"',
    "&apos;": "'",
    "&lt;": "<",
    "&gt;": ">",
    "&nbsp;": " ",
  };

  for (const [k, v] of Object.entries(map)) t = t.split(k).join(v);
  t = t.replace(/&[a-zA-Z]+;/g, "");
  return t;
}

// ---------------- Time formatting: Europe/Amsterdam ----------------
function formatAmsterdamLocal(dateObj) {
  const parts = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Europe/Amsterdam",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  }).formatToParts(dateObj);

  const get = (type) => parts.find((p) => p.type === type)?.value || "00";
  const y = get("year");
  const m = get("month");
  const d = get("day");
  const hh = get("hour");
  const mm = get("minute");
  const ss = get("second");
  return `${y}-${m}-${d}T${hh}:${mm}:${ss}`;
}

function epochFromAmsterdamLocal(year, monthIdx, day, hh, mm, ss = 0) {
  let guess = new Date(Date.UTC(year, monthIdx, day, hh, mm, ss));

  for (let i = 0; i < 3; i++) {
    const local = formatAmsterdamLocal(guess);
    const y = Number(local.slice(0, 4));
    const m = Number(local.slice(5, 7)) - 1;
    const d = Number(local.slice(8, 10));
    const H = Number(local.slice(11, 13));
    const M = Number(local.slice(14, 16));
    const S = Number(local.slice(17, 19));

    const desiredMs = Date.UTC(year, monthIdx, day, hh, mm, ss);
    const seenMs = Date.UTC(y, m, d, H, M, S);
    const delta = desiredMs - seenMs;

    if (delta === 0) break;
    guess = new Date(guess.getTime() + delta);
  }

  return guess.getTime();
}

function slugify(s) {
  return String(s || "")
    .toLowerCase()
    .trim()
    .replace(/['’]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "");
}

// ---------------- Dedupe ----------------
function dedupeCollected(items, lowerKey) {
  const map = new Map();

  for (const ev of items || []) {
    const artist = lowerKey(ev?.artist || "");
    const venue = lowerKey(ev?.venue || "");
    const city = lowerKey(ev?.city || "");
    const ts = Number(ev?.startTs || 0);

    if (!artist || !ts) continue;

    const key = `${artist}|${ts}|${city}|${venue}`;
    const prev = map.get(key);
    if (!prev) {
      map.set(key, ev);
      continue;
    }

    const prevUrl = String(prev?.url || "");
    const curUrl = String(ev?.url || "");
    const prevScore = (prev?.source === "tm" ? 2 : 1) + (prevUrl.startsWith("http") ? 1 : 0);
    const curScore = (ev?.source === "tm" ? 2 : 1) + (curUrl.startsWith("http") ? 1 : 0);

    if (curScore > prevScore) map.set(key, ev);
  }

  return Array.from(map.values());
}

// ---------------- Music-only matching ----------------
function insertSpacesInGluedWords(s) {
  return String(s || "")
    .replace(/([a-z])([A-Z])/g, "$1 $2")
    .replace(/\s{2,}/g, " ")
    .trim();
}

function normalizeArtistCandidate(s) {
  let t = insertSpacesInGluedWords(String(s || "").trim());
  const lk = t.toLowerCase().trim();
  if (lk === "slstafir") return "Sólstafir";
  return t;
}

function splitCandidatesFromText(title) {
  const t0 = String(title || "").trim();
  if (!t0) return [];

  const t = insertSpacesInGluedWords(t0);

  const parts = t
    .replace(/\s+/g, " ")
    .split(/(?:\s+\+\s+|,|\/|&| x | feat\.| ft\.| featuring | presents | w\/| with |\|\||–|-|:)/i)
    .map((x) => x.trim())
    .filter((x) => x.length >= 2);

  return [t, ...parts];
}

function pickBestArtistMatch(ev, lowerKey, tasteSet, ecosystemSet) {
  const primary0 = String(ev?.artist || "").trim();
  const primary = normalizeArtistCandidate(primary0);

  const atts = Array.isArray(ev?.attractions) ? ev.attractions : [];
  const candidates = [];

  if (primary) candidates.push(primary);

  for (const a of atts) {
    const s = normalizeArtistCandidate(String(a || "").trim());
    if (s) candidates.push(s);
  }

  for (const c of splitCandidatesFromText(primary)) candidates.push(normalizeArtistCandidate(c));

  const uniq = [];
  const seen = new Set();

  for (const c of candidates) {
    const s = String(c || "").trim();
    if (!s) continue;

    const k = lowerKey(s);
    if (!k) continue;

    if (seen.has(k)) continue;
    seen.add(k);

    uniq.push({ display: s, lower: k });
  }

  const aliasMap = new Map([["slstafir", "solstafir"]]);
  const applyAlias = (lower) => aliasMap.get(lower) || lower;

  for (const c of uniq) {
    const aliased = applyAlias(c.lower);
    if (tasteSet.has(aliased)) {
      return { ok: true, artistDisplay: c.display, artistLower: aliased, reason: "taste_match" };
    }
  }

  for (const c of uniq) {
    const aliased = applyAlias(c.lower);
    if (ecosystemSet.has(aliased)) {
      return { ok: true, artistDisplay: c.display, artistLower: aliased, reason: "ecosystem_match" };
    }
  }

  return { ok: false, reason: "no_match_to_taste_or_ecosystem" };
}

function attractionBoost(ev, lowerKey, tasteSet) {
  const atts = Array.isArray(ev?.attractions) ? ev.attractions : [];
  if (!atts.length) return 0;

  let hits = 0;
  for (const a of atts) {
    const lk = lowerKey(normalizeArtistCandidate(a));
    if (lk && tasteSet.has(lk)) hits += 1;
  }

  return Math.min(8, hits * 3);
}

// ---------------- Scoring tiers ----------------
function tierFromPlays(plays) {
  const p = Number(plays || 0);
  if (p >= 120) return "core";
  if (p >= 40) return "known";
  if (p >= 10) return "maybe";
  return "discovery";
}

function tierFromEcosystemMatch(match01) {
  const m = Number(match01 || 0);
  if (m >= 0.55) return "known";
  if (m >= 0.25) return "maybe";
  return "discovery";
}

function baseScoreFromTier(tier) {
  if (tier === "core") return 78;
  if (tier === "known") return 62;
  if (tier === "maybe") return 48;
  return 34;
}
// ---------------- Ticketmaster ----------------
async function ticketmasterEvents({ apiKey, countryCode, city, radiusKm, sizeRequested }) {
  const want = Math.max(1, Math.min(1000, Number(sizeRequested) || 1));
  const pageSize = Math.min(200, want);
  const nowIso = new Date().toISOString().replace(/\.\d{3}Z$/, "Z");

  const out = [];
  let page = 0;

  const maxPages = Math.min(10, Math.ceil(want / pageSize) + 2);

  while (out.length < want && page < maxPages) {
    const u = new URL("https://app.ticketmaster.com/discovery/v2/events.json");
    u.searchParams.set("apikey", apiKey);
    u.searchParams.set("countryCode", countryCode);
    u.searchParams.set("classificationName", "music");
    u.searchParams.set("sort", "date,asc");
    u.searchParams.set("size", String(pageSize));
    u.searchParams.set("page", String(page));
    u.searchParams.set("startDateTime", nowIso);

    const cityTrim = String(city || "").trim();
    if (cityTrim) {
      u.searchParams.set("city", cityTrim);
      if (radiusKm != null) {
        u.searchParams.set("radius", String(radiusKm));
        u.searchParams.set("unit", "km");
      }
    }

    const r = await fetch(u.toString(), { method: "GET" });
    const j = await r.json().catch(() => ({}));

    if (!r.ok) {
      const msg = j?.errors?.[0]?.detail || `Ticketmaster HTTP ${r.status}`;
      throw new Error(msg);
    }

    const items = j?._embedded?.events;
    if (!Array.isArray(items) || items.length === 0) break;

    for (const e of items) {
      if (out.length >= want) break;

      const id = String(e?.id || "").trim();
      if (!id) continue;

      const attractions = Array.isArray(e?._embedded?.attractions)
        ? e._embedded.attractions.map((a) => String(a?.name || "").trim()).filter(Boolean)
        : [];

      const artist = attractions[0] || String(e?.name || "").trim();

      const venueObj = Array.isArray(e?._embedded?.venues) ? e._embedded.venues[0] : null;
      const venue = String(venueObj?.name || "").trim();
      const cityName = String(venueObj?.city?.name || "").trim() || cityTrim || "";

      const dt = String(e?.dates?.start?.dateTime || "").trim();
      if (!dt) continue;

      const startDate = new Date(dt);
      if (Number.isNaN(startDate.getTime())) continue;

      const startTs = startDate.getTime();
      const startLocal = formatAmsterdamLocal(startDate);
      const url = String(e?.url || "").trim();

      out.push({
        id: `tm:${id}`,
        artist,
        attractions,
        city: cityName,
        venue: venue || "",
        startTs,
        startLocal,
        url,
      });
    }

    page += 1;
    const pageInfo = j?.page;
    if (pageInfo && Number.isFinite(pageInfo.totalPages) && page >= pageInfo.totalPages) break;
  }

  return out;
}

// ---------------- MetalAgenda (city pages) ----------------
function cityVariants(city) {
  const c = String(city || "").trim();
  const low = c.toLowerCase();
  const dash = low.replace(/\s+/g, "-");

  if (low === "amsterdam") return ["Amsterdam", "amsterdam"];
  if (low === "utrecht") return ["utrecht", "Utrecht"];
  if (low === "rotterdam") return ["Rotterdam", "rotterdam"];
  if (low === "nijmegen") return ["Nijmegen", "nijmegen"];
  if (low === "eindhoven") return ["Eindhoven", "eindhoven"];
  if (low === "tilburg") return ["Tilburg", "tilburg"]; // ✅
  if (low === "maastricht") return ["Maastricht", "maastricht"];
  if (low === "zoetermeer") return ["Zoetermeer", "zoetermeer"];
  if (low === "leeuwarden") return ["Leeuwarden", "leeuwarden"];
  if (low === "hengelo") return ["Hengelo", "hengelo"];
  if (low === "groningen") return ["Groningen", "groningen"];
  if (low === "den haag" || low === "den-haag")
    return ["Den-Haag", "den-haag", "Den%20Haag", "den%20haag"];

  return [c, low, dash];
}

function stripHtmlToLines(html) {
  let s = String(html || "");

  s = s.replace(/<script[\s\S]*?<\/script>/gi, "\n");
  s = s.replace(/<style[\s\S]*?<\/style>/gi, "\n");

  s = s.replace(/<br\s*\/?>/gi, "\n");
  s = s.replace(/<\/(p|div|li|ul|ol|section|article|header|footer)>/gi, "\n");
  s = s.replace(/<\/h[1-6]>/gi, "\n");
  s = s.replace(/<h[1-6][^>]*>/gi, "\n");
  s = s.replace(/<\/tr>/gi, "\n");
  s = s.replace(/<\/td>/gi, " ");

  s = s.replace(/<[^>]+>/g, " ");

  s = decodeHtmlEntities(s);
  s = s.replace(/\r/g, "\n");

  const lines = s
    .split("\n")
    .map((x) => x.replace(/\s+/g, " ").trim())
    .filter(Boolean);

  return lines;
}

function normalizeWeirdSpacedDateLine(line) {
  const t = String(line || "").trim();
  if (!t) return t;

  const noSpaces = t.replace(/\s+/g, "");
  if (!/^\d{1,2}[a-z]{3,}\d{4}/i.test(noSpaces)) return t;

  const m = noSpaces.match(/^(\d{1,2})([a-z]{3,})(\d{4})(.*)$/i);
  if (!m) return t;

  const day = m[1];
  const month = m[2];
  const year = m[3];
  const rest = String(m[4] || "");
  const spaced = `${day} ${month} ${year}${rest ? " " + rest : ""}`.trim();
  return spaced;
}

function parseMADateHeader(line, monthMap) {
  const t0 = normalizeWeirdSpacedDateLine(line);
  const m = t0.match(
    /\b(\d{1,2})\s+(januari|februari|maart|april|mei|juni|juli|augustus|september|oktober|november|december)\s+(\d{4})\b/i
  );
  if (!m) return null;

  const day = Number(m[1]);
  const mon = String(m[2] || "").toLowerCase();
  const year = Number(m[3]);
  const monthIdx = monthMap[mon];
  if (monthIdx == null) return null;

  return { day, monthIdx, year };
}

// detect city from event’s own text
function detectCityFromText(text) {
  const t = String(text || "").toLowerCase();

  const rules = [
    { re: /\bden\s*haag\b|\b's-?gravenhage\b/i, city: "Den Haag" },
    { re: /\bamsterdam\b/i, city: "Amsterdam" },
    { re: /\butrecht\b/i, city: "Utrecht" },
    { re: /\brotterdam\b/i, city: "Rotterdam" },
    { re: /\bzoetermeer\b/i, city: "Zoetermeer" },
    { re: /\bnijmegen\b/i, city: "Nijmegen" },
    { re: /\beindhoven\b/i, city: "Eindhoven" },
    { re: /\btilburg\b/i, city: "Tilburg" }, // ✅ detect too
    { re: /\bmaastricht\b/i, city: "Maastricht" },
    { re: /\bleeuwarden\b/i, city: "Leeuwarden" },
    { re: /\bhengelo\b/i, city: "Hengelo" },
    { re: /\bgroningen\b/i, city: "Groningen" },
    { re: /\bhaarlem\b/i, city: "Haarlem" },
  ];

  for (const r of rules) {
    if (r.re.test(t)) return r.city;
  }
  return "";
}

async function metalAgendaEventsByCities({ maxEvents, countryCode, city, debug }) {
  if (String(countryCode || "").toUpperCase() !== "NL") {
    return { pagesFetched: 0, eventsParsed: 0, events: [], fetchMeta: [] };
  }

  const want = Math.max(1, Math.min(1000, Number(maxEvents) || 50));

  // ✅ Tilburg INCLUDED
  // NOTE: Haarlem stays OUT of search list (as you wanted)
  const defaultCities = [
    "Amsterdam",
    "Utrecht",
    "Rotterdam",
    "Den Haag",
    "Nijmegen",
    "Eindhoven",
    "Tilburg",
    "Maastricht",
    "Zoetermeer",
    "Leeuwarden",
    "Hengelo",
  ];

  const cityTrim = String(city || "").trim();
  const cities = cityTrim ? [cityTrim] : defaultCities;

  const events = [];
  let pagesFetched = 0;
  let eventsParsed = 0;

  const fetchMeta = [];
  const concurrency = Math.min(4, cities.length || 1);
  let idx = 0;

  const runner = async () => {
    while (idx < cities.length && events.length < want) {
      const cityName = cities[idx++];
      const vars = cityVariants(cityName);

      let best = null;

      for (const v of vars) {
        const pageUrl = `https://www.metalagenda.nl/p/${v}`;

        const res = await fetchTextWithStatus(pageUrl).catch(() => ({
          ok: false,
          status: 0,
          url: pageUrl,
          text: "",
        }));

        pagesFetched += 1;

        const bytes = (res.text || "").length;
        const low = String(res.text || "").toLowerCase();

        // ✅ RELAXED heuristic: do NOT require specific markers (this was killing Tilburg)
        const looksLikeNotFound =
          low.includes("pagina niet gevonden") ||
          low.includes("not found") ||
          low.includes("404") ||
          low.includes("error 404");

        const looksOk = res.ok && bytes > 800 && !looksLikeNotFound;

        if (debug) {
          fetchMeta.push({
            city: cityName,
            tried: pageUrl,
            status: res.status,
            finalUrl: res.url,
            bytes,
            looksOk,
          });
        }

        if (looksOk) {
          best = { url: pageUrl, html: res.text };
          break;
        }
      }

      if (!best) continue;

      const parsed = parseMetalAgendaCityContent(best.url, cityName, best.html);
      eventsParsed += parsed.length;

      for (const ev of parsed) {
        events.push(ev);
        if (events.length >= want) break;
      }
    }
  };

  await Promise.all(Array.from({ length: concurrency }, () => runner()));

  const cutoff = Date.now() - 12 * 60 * 60 * 1000;
  const upcoming = events.filter((e) => Number(e?.startTs) >= cutoff);
  upcoming.sort((a, b) => a.startTs - b.startTs);

  return {
    pagesFetched,
    eventsParsed,
    events: upcoming.slice(0, want),
    fetchMeta: debug ? fetchMeta.slice(0, 200) : [],
  };
}

function parseMetalAgendaCityContent(pageUrl, cityName, html) {
  const monthMap = {
    januari: 0, februari: 1, maart: 2, april: 3, mei: 4, juni: 5,
    juli: 6, augustus: 7, september: 8, oktober: 9, november: 10, december: 11,
  };

  const lines = stripHtmlToLines(html);

  const out = [];
  let cur = null; // {day,monthIdx,year}
  let lastNonEmpty = "";

  const isBandsLine = (s) => /^\s*Bands:\s*/i.test(String(s || ""));
  const cleanBandsLine = (s) =>
    String(s || "").replace(/^\s*Bands:\s*/i, "").trim();

  const isArtistHeadingLike = (s) => {
    const t = String(s || "").trim();
    if (!t) return false;
    if (/^#{2,6}\s+/.test(t)) return true;
    if (/^(postcode|top|favo|updates|inschrijven|aankomende)\b/i.test(t)) return false;
    if (/^metal concerten/i.test(t)) return false;
    if (isBandsLine(t)) return false;
    if (parseMADateHeader(t, monthMap)) return false;
    return t.length >= 2 && t.length <= 140;
  };

  const normalizeHeadingText = (s) =>
    String(s || "").replace(/^#{2,6}\s+/, "").replace(/\s+/g, " ").trim();

  for (let i = 0; i < lines.length; i++) {
    const raw = lines[i];
    const line = normalizeWeirdSpacedDateLine(raw);

    const d = parseMADateHeader(line, monthMap);
    if (d) {
      cur = d;
      lastNonEmpty = line;
      continue;
    }

    // Style A: "Bands:" line defines event
    if (cur && isBandsLine(line)) {
      const bandsRaw = cleanBandsLine(line);
      const bands = bandsRaw
        ? decodeHtmlEntities(bandsRaw)
            .split("|")
            .map((x) => insertSpacesInGluedWords(x).trim())
            .filter(Boolean)
        : [];

      const headliner = String(bands[0] || "").trim();
      if (!headliner) {
        lastNonEmpty = line;
        continue;
      }

      let hh = 20, mm = 0;

      const near = `${lastNonEmpty}\n${line}\n${lines[i + 1] || ""}`;
      const mt = String(near).match(/\b([01]\d|2[0-3]):([0-5]\d)\b/);
      if (mt) {
        hh = Number(mt[1]);
        mm = Number(mt[2]);
      }

      const startTs = epochFromAmsterdamLocal(cur.year, cur.monthIdx, cur.day, hh, mm, 0);
      const startLocal = formatAmsterdamLocal(new Date(startTs));

      const venueHint = String(lastNonEmpty || "").trim();
      const detectedCity = detectCityFromText(venueHint);
      const finalCity = detectedCity || cityName || "";

      out.push({
        id: `ma:${slugify(finalCity)}:${cur.year}-${String(cur.monthIdx + 1).padStart(2, "0")}-${String(cur.day).padStart(2, "0")}:${slugify(headliner)}:${slugify(finalCity)}`,
        artist: headliner,
        attractions: bands.length ? bands : [headliner],
        city: finalCity,
        venue: "",
        startTs,
        startLocal,
        url: pageUrl,
        _maVenueHint: venueHint,
      });

      lastNonEmpty = line;
      continue;
    }

    // Style B: date → heading → venue line
    if (cur && isArtistHeadingLike(line)) {
      const artist = normalizeArtistCandidate(normalizeHeadingText(line));
      const artistClean = String(artist || "").trim();
      if (!artistClean) {
        lastNonEmpty = line;
        continue;
      }

      const next = String(lines[i + 1] || "").trim();
      const nextIsDate = !!parseMADateHeader(next, monthMap);
      const nextIsBands = isBandsLine(next);
      const venueLine = !nextIsDate && !nextIsBands ? next : "";

      let hh = 20, mm = 0;
      const mt = `${line}\n${venueLine}`.match(/\b([01]\d|2[0-3]):([0-5]\d)\b/);
      if (mt) {
        hh = Number(mt[1]);
        mm = Number(mt[2]);
      }

      const startTs = epochFromAmsterdamLocal(cur.year, cur.monthIdx, cur.day, hh, mm, 0);
      const startLocal = formatAmsterdamLocal(new Date(startTs));

      const detectedCity = detectCityFromText(venueLine) || detectCityFromText(lastNonEmpty);
      const finalCity = detectedCity || cityName || "";

      out.push({
        id: `ma:${slugify(finalCity)}:${cur.year}-${String(cur.monthIdx + 1).padStart(2, "0")}-${String(cur.day).padStart(2, "0")}:${slugify(artistClean)}:${slugify(finalCity)}`,
        artist: artistClean,
        attractions: [artistClean],
        city: finalCity,
        venue: "",
        startTs,
        startLocal,
        url: pageUrl,
        _maVenueHint: venueLine || "",
      });

      lastNonEmpty = line;
      continue;
    }

    if (line) lastNonEmpty = line;
  }

  const seen = new Set();
  const uniq = [];
  for (const e of out) {
    const k = `${String(e.city)}|${String(e.artist).toLowerCase()}|${Number(e.startTs)}`;
    if (seen.has(k)) continue;
    seen.add(k);
    uniq.push(e);
  }

  return uniq;
}

// ---------------- TivoliVredenburg ----------------
async function tivoliAgendaEvents({ maxEvents, countryCode, maxPages = 10, hydrateLimit = 14 }) {
  if (String(countryCode || "").toUpperCase() !== "NL") {
    return { pagesFetched: 0, eventsParsed: 0, events: [] };
  }

  const want = Math.max(1, Math.min(1000, Number(maxEvents) || 50));
  const events = [];

  let pagesFetched = 0;
  let eventsParsed = 0;

  const pages = Math.max(1, Math.min(20, Number(maxPages) || 10));

  for (let page = 1; page <= pages && events.length < want; page++) {
    const pageUrl = `https://www.tivolivredenburg.nl/agenda/page/${page}/`;

    const r = await fetchTextWithStatus(pageUrl).catch(() => ({ ok: false, text: "" }));
    pagesFetched += 1;

    if (!r.ok || !r.text) continue;

    const parsed = parseTivoliAgendaHtml(r.text);
    eventsParsed += parsed.length;

    for (const ev of parsed) {
      if (events.length >= want) break;
      events.push(ev);
    }
  }

  const cutoff = Date.now() - 12 * 60 * 60 * 1000;
  const upcoming = events.filter((e) => Number(e?.startTs) >= cutoff);

  const seen = new Set();
  const uniq = [];

  for (const e of upcoming) {
    const k = String(e.url || "");
    if (!k) continue;
    if (seen.has(k)) continue;
    seen.add(k);
    uniq.push(e);
  }

  const toHydrate = uniq.slice(0, Math.max(0, Math.min(50, Number(hydrateLimit) || 0)));
  const rest = uniq.slice(toHydrate.length);

  const hydratedHead = await mapLimit(toHydrate, 6, async (ev) => {
    const full = await tivoliHydrateEvent(ev).catch(() => null);
    return full || ev;
  });

  const hydrated = hydratedHead.concat(rest);
  hydrated.sort((a, b) => a.startTs - b.startTs);

  return { pagesFetched, eventsParsed, events: hydrated.slice(0, want) };
}

function parseTivoliAgendaHtml(html) {
  const out = [];

  const monthMap = {
    jan: 0, "jan.": 0, feb: 1, "feb.": 1, mrt: 2, "mrt.": 2, apr: 3, "apr.": 3,
    mei: 4, jun: 5, "jun.": 5, jul: 6, "jul.": 6, aug: 7, "aug.": 7,
    sep: 8, "sep.": 8, okt: 9, "okt.": 9, nov: 10, "nov.": 10, dec: 11, "dec.": 11,
  };

  const re =
    /\b(ma|di|wo|do|vr|za|zo)\s+(\d{1,2})\s+([a-z]{3}.?)\s+(\d{4})[\s\S]{0,900}?href="(https:\/\/www\.tivolivredenburg\.nl\/agenda\/[^"]+)"[^>]*>\s*([^<]{2,180})\s*<\/a>/gi;

  let m;
  while ((m = re.exec(String(html))) && out.length < 5000) {
    const day = Number(m[2]);
    const monRaw = String(m[3] || "").toLowerCase();
    const year = Number(m[4]);
    const url = String(m[5] || "").trim();

    let title = String(m[6] || "").trim();
    title = decodeHtmlEntities(title).replace(/\s+/g, " ").trim();

    const monthIdx = monthMap[monRaw];
    if (monthIdx == null) continue;
    if (!title || !url) continue;

    const startTs = epochFromAmsterdamLocal(year, monthIdx, day, 20, 0, 0);
    const startLocal = formatAmsterdamLocal(new Date(startTs));

    out.push({
      id: `tv:${slugify(title)}:${year}-${String(monthIdx + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`,
      artist: title,
      attractions: [title],
      city: "Utrecht",
      venue: "TivoliVredenburg",
      startTs,
      startLocal,
      url,
    });
  }

  return out;
}

async function tivoliHydrateEvent(ev) {
  const url = String(ev?.url || "");
  if (!url.startsWith("https://www.tivolivredenburg.nl/agenda/")) return ev;

  const r = await fetchTextWithStatus(url).catch(() => ({ ok: false, text: "" }));
  if (!r.ok || !r.text) return ev;

  const html = r.text;

  const jsonLdBlocks = [];
  const reLd = /<script[^>]+type=["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi;

  let m;
  while ((m = reLd.exec(html))) {
    const raw = String(m[1] || "").trim();
    if (raw) jsonLdBlocks.push(raw);
  }

  let startTs = ev.startTs;
  let startLocal = ev.startLocal;

  for (const blk of jsonLdBlocks) {
    const txt = blk.replace(/\n/g, " ").trim();
    const sm = txt.match(/"startDate"\s*:\s*"([^"]+)"/i);
    if (sm) {
      const iso = String(sm[1] || "").trim();
      const d = new Date(iso);
      if (!Number.isNaN(d.getTime())) {
        startTs = d.getTime();
        startLocal = formatAmsterdamLocal(new Date(startTs));
        break;
      }
    }
  }

  if (startTs === ev.startTs) {
    const sm2 = html.match(/datetime=["']([^"']+)["']/i);
    if (sm2) {
      const iso = String(sm2[1] || "").trim();
      const d = new Date(iso);
      if (!Number.isNaN(d.getTime())) {
        startTs = d.getTime();
        startLocal = formatAmsterdamLocal(new Date(startTs));
      }
    }
  }

  let title = ev.artist;
  const h1m = html.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i);
  if (h1m) {
    const t = decodeHtmlEntities(h1m[1])
      .replace(/<[^>]+>/g, " ")
      .replace(/\s+/g, " ")
      .trim();
    if (t && t.length >= 2) title = t;
  }

  let zaal = "";
  const zaalM = html.match(
    /\b(Zaal|Hall|Room)\b[\s\S]{0,80}?\b(Ronda|Pandora|Cloud Nine|Hertz|Grote Zaal|Kleine Zaal)\b/i
  );
  if (zaalM) zaal = String(zaalM[2] || "").trim();

  return {
    ...ev,
    artist: title,
    attractions: [title],
    venue: zaal ? `TivoliVredenburg (${zaal})` : "TivoliVredenburg",
    startTs,
    startLocal,
  };
}

