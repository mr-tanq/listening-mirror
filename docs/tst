// ---------------- Last.fm ----------------
async function lastfmTopArtistsOverall(apiKey, user, limit) {
  const u = new URL("https://ws.audioscrobbler.com/2.0/");
  u.searchParams.set("method", "user.gettopartists");
  u.searchParams.set("user", user);
  u.searchParams.set("api_key", apiKey);
  u.searchParams.set("format", "json");
  u.searchParams.set("limit", String(limit));
  u.searchParams.set("period", "overall");

  const r = await fetch(u.toString(), { method: "GET" });
  const j = await r.json().catch(() => ({}));

  if (!r.ok) throw new Error(`Last.fm HTTP ${r.status}`);
  if (j && j.error) throw new Error(`Last.fm: ${j.message || "error"}`);

  const arr = j?.topartists?.artist;
  if (!Array.isArray(arr)) return [];

  const out = [];
  for (const a of arr) {
    const name = String(a?.name || "").trim();
    const playcount = Number(a?.playcount || 0);
    if (!name) continue;
    out.push({ name, playcount: Number.isFinite(playcount) ? playcount : 0 });
  }

  out.sort((a, b) => (b.playcount - a.playcount));
  return out;
}

async function lastfmGetSimilar(apiKey, artistName, limit) {
  const u = new URL("https://ws.audioscrobbler.com/2.0/");
  u.searchParams.set("method", "artist.getsimilar");
  u.searchParams.set("artist", artistName);
  u.searchParams.set("api_key", apiKey);
  u.searchParams.set("format", "json");
  u.searchParams.set("limit", String(limit || 50));
  u.searchParams.set("autocorrect", "1");

  const r = await fetch(u.toString(), { method: "GET" });
  const j = await r.json().catch(() => ({}));

  if (!r.ok) throw new Error(`Last.fm similar HTTP ${r.status}`);
  if (j && j.error) throw new Error(`Last.fm similar: ${j.message || "error"}`);

  const arr = j?.similarartists?.artist;
  if (!Array.isArray(arr)) return [];

  const out = [];
  for (const a of arr) {
    const name = String(a?.name || "").trim();
    const match = Number(a?.match || a?.similarity || 0);
    if (!name) continue;
    out.push({ name, match: Number.isFinite(match) ? match : 0 });
  }
  return out;
}

async function buildEcosystemCached(apiKey, seeds, limit, lowerKey, ctx) {
  const set = new Set();
  const weightMap = new Map(); // nameLower -> bestMatch
  const seedList = Array.isArray(seeds) ? seeds.slice(0, 20) : [];

  for (const s of seedList) {
    const lk = lowerKey(s);
    if (!lk) continue;
    set.add(lk);
    weightMap.set(lk, Math.max(weightMap.get(lk) || 0, 1));
  }

  for (const seed of seedList) {
    const cached = await cacheGetSimilar(apiKey, seed, limit).catch(() => null);
    const arr = Array.isArray(cached) ? cached : [];

    for (const it of arr) {
      const name = String(it?.name || "").trim();
      const lk = lowerKey(name);
      if (!lk) continue;
      set.add(lk);

      const m = Number(it?.match || 0);
      const prev = weightMap.get(lk) || 0;
      if (m > prev) weightMap.set(lk, m);
    }
  }

  return { set, weightMap };
}

async function cacheGetSimilar(apiKey, seed, limit) {
  const key = `lm:lastfm:similar:v1:${encodeURIComponent(String(seed || "").trim().toLowerCase())}:L${Number(limit || 50)}`;
  const cache = caches.default;

  const req = new Request("https://cache.local/" + key, { method: "GET" });
  const hit = await cache.match(req);
  if (hit) {
    const j = await hit.json().catch(() => null);
    if (Array.isArray(j)) return j;
  }

  const fresh = await lastfmGetSimilar(apiKey, seed, limit);
  const res = new Response(JSON.stringify(fresh), {
    headers: {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "public, max-age=604800",
    },
  });
  cache.put(req, res.clone()).catch(() => {});
  return fresh;
}

// ---------------- fetch helpers ----------------
async function fetchText(u) {
  const r = await fetch(u, {
    method: "GET",
    headers: {
      "accept": "text/html,*/*",
      "user-agent": "ListeningMirror/1.0 (mr-tanq)",
    },
  });
  if (!r.ok) return "";
  return await r.text().catch(() => "");
}

function decodeHtmlEntities(s) {
  let t = String(s || "");

  t = t.replace(/&#(\d+);/g, (_, n) => {
    const code = Number(n);
    if (!Number.isFinite(code)) return _;
    try { return String.fromCodePoint(code); } catch { return _; }
  });

  const map = {
    "&eacute;": "é",
    "&Eacute;": "É",
    "&ouml;": "ö",
    "&Ouml;": "Ö",
    "&uuml;": "ü",
    "&Uuml;": "Ü",
    "&auml;": "ä",
    "&Auml;": "Ä",
    "&oslash;": "ø",
    "&Oslash;": "Ø",
    "&amp;": "&",
    "&quot;": "\"",
    "&#39;": "'",
    "&lt;": "<",
    "&gt;": ">",
    "&nbsp;": " ",
  };

  for (const [k, v] of Object.entries(map)) {
    t = t.split(k).join(v);
  }
  t = t.replace(/&[a-zA-Z]+;/g, "");
  return t;
}

function htmlToText(html) {
  let s = String(html || "");
  s = s.replace(/<br\s*\/?>/gi, "\n");
  s = s.replace(/<\/p>/gi, "\n");
  s = s.replace(/<\/h\d>/gi, "\n");
  s = s.replace(/<\/li>/gi, "\n");
  s = s.replace(/<\/div>/gi, "\n");
  s = s.replace(/<[^>]+>/g, " ");
  s = s.replace(/\r/g, "\n");
  s = s.replace(/\n{3,}/g, "\n\n");
  return s.trim();
}

// ---------------- Time formatting: Europe/Amsterdam ----------------
function formatAmsterdamLocal(dateObj) {
  const parts = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Europe/Amsterdam",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  }).formatToParts(dateObj);

  const get = (type) => parts.find((p) => p.type === type)?.value || "00";
  const y = get("year");
  const m = get("month");
  const d = get("day");
  const hh = get("hour");
  const mm = get("minute");
  const ss = get("second");

  return `${y}-${m}-${d}T${hh}:${mm}:${ss}`;
}

function epochFromAmsterdamLocal(year, monthIdx, day, hh, mm, ss = 0) {
  let guess = new Date(Date.UTC(year, monthIdx, day, hh, mm, ss));

  for (let i = 0; i < 3; i++) {
    const local = formatAmsterdamLocal(guess);
    const y = Number(local.slice(0, 4));
    const m = Number(local.slice(5, 7)) - 1;
    const d = Number(local.slice(8, 10));
    const H = Number(local.slice(11, 13));
    const M = Number(local.slice(14, 16));
    const S = Number(local.slice(17, 19));

    const desiredMs = Date.UTC(year, monthIdx, day, hh, mm, ss);
    const seenMs = Date.UTC(y, m, d, H, M, S);
    const delta = desiredMs - seenMs;
    if (delta === 0) break;
    guess = new Date(guess.getTime() + delta);
  }

  return guess.getTime();
}

function slugify(s) {
  return String(s || "")
    .toLowerCase()
    .trim()
    .replace(/['’]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "");
}

// ---------------- Dedupe ----------------
function dedupeCollected(items, lowerKey) {
  const map = new Map();
  for (const ev of items || []) {
    const artist = lowerKey(ev?.artist || "");
    const venue = lowerKey(ev?.venue || "");
    const city = lowerKey(ev?.city || "");
    const ts = Number(ev?.startTs || 0);
    if (!artist || !ts) continue;

    const key = `${artist}|${ts}|${city}|${venue}`;
    const prev = map.get(key);
    if (!prev) {
      map.set(key, ev);
      continue;
    }

    const prevUrl = String(prev?.url || "");
    const curUrl = String(ev?.url || "");
    const prevScore = (prev?.source === "tm" ? 2 : 1) + (prevUrl.startsWith("http") ? 1 : 0);
    const curScore = (ev?.source === "tm" ? 2 : 1) + (curUrl.startsWith("http") ? 1 : 0);

    if (curScore > prevScore) map.set(key, ev);
  }
  return Array.from(map.values());
}
