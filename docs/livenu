export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // --- CORS ---
    const origin = request.headers.get("Origin") || "";
    const allowed = new Set([
      "https://mr-tanq.github.io",
      "http://localhost:5173",
      "http://localhost:4173",
      "http://localhost:3000",
    ]);

    const allowOrigin = allowed.has(origin) ? origin : "https://mr-tanq.github.io";
    const corsHeaders = {
      "access-control-allow-origin": allowOrigin,
      "access-control-allow-methods": "GET,POST,OPTIONS",
      "access-control-allow-headers": "content-type, authorization",
      "access-control-max-age": "86400",
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { status: 204, headers: corsHeaders });
    }

    const jsonRes = (obj, status = 200) =>
      new Response(JSON.stringify(obj, null, 2), {
        status,
        headers: {
          "content-type": "application/json; charset=utf-8",
          ...corsHeaders,
        },
      });

    const lowerKey = (s) => String(s || "").trim().toLowerCase();

    const clampInt = (v, a, b, fallback) => {
      const n = Number(v);
      if (!Number.isFinite(n)) return fallback;
      return Math.max(a, Math.min(b, Math.trunc(n)));
    };

    try {
      if (url.pathname === "/health") {
        return jsonRes({ ok: true, service: "live", time: new Date().toISOString() });
      }

      if (url.pathname === "/econcerts") {
        return await handleEconcerts(request, env, ctx, jsonRes, lowerKey, clampInt);
      }

      return jsonRes({ ok: false, error: "not_found", path: url.pathname }, 404);
    } catch (err) {
      return jsonRes(
        {
          ok: false,
          error: "internal_error",
          message: String(err?.message || err),
        },
        500
      );
    }
  },
};

async function handleEconcerts(request, env, ctx, jsonRes, lowerKey, clampInt) {
  const url = new URL(request.url);

  const TMASTER_API_KEY = String(env.TMASTER_API_KEY || "").trim();
  const LASTFM_API_KEY = String(env.LASTFM_API_KEY || "").trim();
  const LASTFM_USER = String(env.LASTFM_USER || "").trim();

  const size = clampInt(url.searchParams.get("size"), 1, 1000, 50);
  const radiusKm = clampInt(url.searchParams.get("radiusKm"), 1, 500, 30);
  const scoreMin = clampInt(url.searchParams.get("scoreMin"), 0, 100, 0);

  // Forced
  const tasteArtists = 1000;

  const cityRaw = String(url.searchParams.get("city") || "").trim();
  const city = cityRaw;

  const countryCode = String(url.searchParams.get("countryCode") || "NL")
    .trim()
    .toUpperCase();

  const sources = parseSources(String(url.searchParams.get("sources") || "tm,ma,tv"));
  const debug = String(url.searchParams.get("debug") || "").trim() === "1";

  if (!LASTFM_API_KEY) {
    return jsonRes({ ok: false, error: "missing_env", message: "Missing LASTFM_API_KEY" }, 500);
  }
  if (!LASTFM_USER) {
    return jsonRes({ ok: false, error: "missing_env", message: "Missing LASTFM_USER" }, 500);
  }
  if (sources.includes("tm") && !TMASTER_API_KEY) {
    return jsonRes({ ok: false, error: "missing_env", message: "Missing TMASTER_API_KEY" }, 500);
  }

  // ---------------- Taste ----------------
  const taste = await lastfmTopArtistsOverall(LASTFM_API_KEY, LASTFM_USER, tasteArtists);
  const tasteMap = new Map(taste.map((x) => [lowerKey(x.name), x.playcount]));
  const tasteSet = new Set(taste.map((x) => lowerKey(x.name)));

  // ---------------- Ecosystem (cached) ----------------
  const SIMILAR_SEEDS = 8;
  const SIMILAR_LIMIT = 50;

  const seeds = taste
    .slice(0, SIMILAR_SEEDS)
    .map((x) => x.name)
    .filter(Boolean);

  const ecoBuild = await buildEcosystemCached(LASTFM_API_KEY, seeds, SIMILAR_LIMIT, lowerKey);
  const ecosystemSet = ecoBuild.set;
  const ecosystemWeight = ecoBuild.weightMap;

  // ---------------- Collect events ----------------
  const collected = [];

  let tmEventsParsed = null;
  if (sources.includes("tm")) {
    const tmEvents = await ticketmasterEvents({
      apiKey: TMASTER_API_KEY,
      countryCode,
      city: city || "",
      radiusKm: city ? radiusKm : null,
      sizeRequested: size,
    });

    tmEventsParsed = tmEvents.length;
    for (const ev of tmEvents) collected.push({ ...ev, source: "tm" });
  }

  let maPagesFetched = 0;
  let maEventsParsed = 0;
  let maFetchMeta = [];
  if (sources.includes("ma")) {
    const maRes = await metalAgendaEventsByCities({ maxEvents: size, countryCode, debug });
    maPagesFetched = maRes.pagesFetched;
    maEventsParsed = maRes.eventsParsed;
    maFetchMeta = maRes.fetchMeta || [];
    for (const ev of maRes.events) collected.push({ ...ev, source: "ma" });
  }

  let tvPagesFetched = 0;
  let tvEventsParsed = 0;
  if (sources.includes("tv")) {
    const tvRes = await tivoliAgendaEvents({
      maxEvents: size,
      countryCode,
      maxPages: 10,
      hydrateLimit: 14,
    });
    tvPagesFetched = tvRes.pagesFetched;
    tvEventsParsed = tvRes.eventsParsed;
    for (const ev of tvRes.events) collected.push({ ...ev, source: "tv" });
  }

  const deduped = dedupeCollected(collected, lowerKey);

  // ---------------- Music-only filter + scoring ----------------
  const dropped = [];
  const eventsScored = [];

  for (const ev of deduped) {
    const pick = pickBestArtistMatch(ev, lowerKey, tasteSet, ecosystemSet);

    if (!pick.ok) {
      if (debug && dropped.length < 300) {
        dropped.push({
          id: ev.id,
          source: ev.source || "",
          title: ev.artist || "",
          url: ev.url || "",
          reason: pick.reason,
        });
      }
      continue;
    }

    const artistLower = pick.artistLower;
    const plays = tasteMap.get(artistLower) || 0;
    const inTaste = tasteSet.has(artistLower);
    const ecoMatch = ecosystemWeight.get(artistLower) || 0;

    const tier = inTaste ? tierFromPlays(plays) : tierFromEcosystemMatch(ecoMatch);

    let score = baseScoreFromTier(tier);
    score = Math.max(
      0,
      Math.min(100, Math.round(score + attractionBoost(ev, lowerKey, tasteSet)))
    );

    const level = score >= 80 ? "strong" : score >= 65 ? "good" : score >= 50 ? "ok" : "weak";

    if (score >= scoreMin) {
      eventsScored.push({
        id: ev.id,
        artist: pick.artistDisplay,
        attractions: ev.attractions,
        city: ev.city,
        venue: ev.venue,
        start: ev.startLocal,
        url: ev.url,
        plays,
        tier,
        score,
        level,
        startTs: ev.startTs,
        source: ev.source || "tm",
        star: false,
      });
    }
  }

  eventsScored.sort((a, b) => b.score - a.score || a.startTs - b.startTs);
  const finalEvents = eventsScored.slice(0, size);

  return jsonRes({
    ok: true,
    meta: {
      sizeRequested: size,
      radiusKm: city ? radiusKm : null,
      scoreMin,
      tasteArtists,
      eventsFetched: deduped.length,
      eventsReturned: finalEvents.length,
      city: city || null,
      countryCode,
      sources,
      mode: city ? "near_city" : "nl_wide",
      tmEventsParsed,
      maPagesFetched: sources.includes("ma") ? maPagesFetched : null,
      maEventsParsed: sources.includes("ma") ? maEventsParsed : null,
      maFetch: debug ? maFetchMeta : undefined,
      tvPagesFetched: sources.includes("tv") ? tvPagesFetched : null,
      tvEventsParsed: sources.includes("tv") ? tvEventsParsed : null,
      model: "music_only_ecosystem_no_distance_no_time",
      ecosystem: {
        tasteCount: taste.length,
        ecosystemCount: ecosystemSet.size,
        similarSeedsUsed: seeds.length,
      },
      droppedCount: debug ? dropped.length : undefined,
    },
    events: finalEvents,
    dropped: debug ? dropped : undefined,
  });
}

function parseSources(raw) {
  const s = String(raw || "tm")
    .split(",")
    .map((x) => x.trim().toLowerCase())
    .filter(Boolean);

  const out = [];
  for (const x of s) {
    if (x === "tm" || x === "ticketmaster") out.push("tm");
    if (x === "ma" || x === "metalagenda") out.push("ma");
    if (x === "tv" || x === "tivoli" || x === "tivolivredenburg") out.push("tv");
  }
  return out.length ? Array.from(new Set(out)) : ["tm"];
}

// ---------------- Last.fm ----------------
async function lastfmTopArtistsOverall(apiKey, user, limit) {
  const u = new URL("https://ws.audioscrobbler.com/2.0/");
  u.searchParams.set("method", "user.gettopartists");
  u.searchParams.set("user", user);
  u.searchParams.set("api_key", apiKey);
  u.searchParams.set("format", "json");
  u.searchParams.set("limit", String(limit));
  u.searchParams.set("period", "overall");

  const r = await fetch(u.toString(), { method: "GET" });
  const j = await r.json().catch(() => ({}));

  if (!r.ok) throw new Error(`Last.fm HTTP ${r.status}`);
  if (j && j.error) throw new Error(`Last.fm: ${j.message || "error"}`);

  const arr = j?.topartists?.artist;
  if (!Array.isArray(arr)) return [];

  const out = [];
  for (const a of arr) {
    const name = String(a?.name || "").trim();
    const playcount = Number(a?.playcount || 0);
    if (!name) continue;
    out.push({ name, playcount: Number.isFinite(playcount) ? playcount : 0 });
  }

  out.sort((a, b) => b.playcount - a.playcount);
  return out;
}

async function lastfmGetSimilar(apiKey, artistName, limit) {
  const u = new URL("https://ws.audioscrobbler.com/2.0/");
  u.searchParams.set("method", "artist.getsimilar");
  u.searchParams.set("artist", artistName);
  u.searchParams.set("api_key", apiKey);
  u.searchParams.set("format", "json");
  u.searchParams.set("limit", String(limit || 50));
  u.searchParams.set("autocorrect", "1");

  const r = await fetch(u.toString(), { method: "GET" });
  const j = await r.json().catch(() => ({}));

  if (!r.ok) throw new Error(`Last.fm similar HTTP ${r.status}`);
  if (j && j.error) throw new Error(`Last.fm similar: ${j.message || "error"}`);

  const arr = j?.similarartists?.artist;
  if (!Array.isArray(arr)) return [];

  const out = [];
  for (const a of arr) {
    const name = String(a?.name || "").trim();
    const match = Number(a?.match || a?.similarity || 0);
    if (!name) continue;
    out.push({ name, match: Number.isFinite(match) ? match : 0 });
  }
  return out;
}

async function buildEcosystemCached(apiKey, seeds, limit, lowerKey) {
  const set = new Set();
  const weightMap = new Map();

  const seedList = Array.isArray(seeds) ? seeds.slice(0, 20) : [];
  for (const s of seedList) {
    const lk = lowerKey(s);
    if (!lk) continue;
    set.add(lk);
    weightMap.set(lk, Math.max(weightMap.get(lk) || 0, 1));
  }

  for (const seed of seedList) {
    const cached = await cacheGetSimilar(apiKey, seed, limit).catch(() => null);
    const arr = Array.isArray(cached) ? cached : [];

    for (const it of arr) {
      const name = String(it?.name || "").trim();
      const lk = lowerKey(name);
      if (!lk) continue;

      set.add(lk);
      const m = Number(it?.match || 0);
      const prev = weightMap.get(lk) || 0;
      if (m > prev) weightMap.set(lk, m);
    }
  }

  return { set, weightMap };
}

async function cacheGetSimilar(apiKey, seed, limit) {
  const key = `lm:lastfm:similar:v2:${encodeURIComponent(
    String(seed || "").trim().toLowerCase()
  )}:L${Number(limit || 50)}`;

  const cache = caches.default;
  const req = new Request("https://cache.local/" + key, { method: "GET" });

  const hit = await cache.match(req);
  if (hit) {
    const j = await hit.json().catch(() => null);
    if (Array.isArray(j)) return j;
  }

  const fresh = await lastfmGetSimilar(apiKey, seed, limit);
  const res = new Response(JSON.stringify(fresh), {
    headers: {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "public, max-age=604800",
    },
  });

  cache.put(req, res.clone()).catch(() => {});
  return fresh;
}

// ---------------- fetch helpers ----------------
async function fetchTextWithStatus(u) {
  const r = await fetch(u, {
    method: "GET",
    headers: {
      accept: "text/html,*/*",
      "user-agent": "ListeningMirror/1.0 (mr-tanq)",
    },
    redirect: "follow",
  });

  const text = r.ok ? await r.text().catch(() => "") : "";
  return { ok: r.ok, status: r.status, url: r.url || u, text };
}

function decodeHtmlEntities(s) {
  let t = String(s || "");

  t = t.replace(/&#(\d+);/g, (_, n) => {
    const code = Number(n);
    if (!Number.isFinite(code)) return _;
    try {
      return String.fromCodePoint(code);
    } catch {
      return _;
    }
  });

  const map = {
    "&eacute;": "é",
    "&Eacute;": "É",
    "&ouml;": "ö",
    "&Ouml;": "Ö",
    "&uuml;": "ü",
    "&Uuml;": "Ü",
    "&auml;": "ä",
    "&Auml;": "Ä",
    "&oslash;": "ø",
    "&Oslash;": "Ø",
    "&amp;": "&",
    "&quot;": '"',
    "&apos;": "'",
    "&lt;": "<",
    "&gt;": ">",
    "&nbsp;": " ",
  };

  for (const [k, v] of Object.entries(map)) t = t.split(k).join(v);
  t = t.replace(/&[a-zA-Z]+;/g, "");
  return t;
}

// ---------------- Time formatting: Europe/Amsterdam ----------------
function formatAmsterdamLocal(dateObj) {
  const parts = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Europe/Amsterdam",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  }).formatToParts(dateObj);

  const get = (type) => parts.find((p) => p.type === type)?.value || "00";
  const y = get("year");
  const m = get("month");
  const d = get("day");
  const hh = get("hour");
  const mm = get("minute");
  const ss = get("second");
  return `${y}-${m}-${d}T${hh}:${mm}:${ss}`;
}

function epochFromAmsterdamLocal(year, monthIdx, day, hh, mm, ss = 0) {
  let guess = new Date(Date.UTC(year, monthIdx, day, hh, mm, ss));

  for (let i = 0; i < 3; i++) {
    const local = formatAmsterdamLocal(guess);
    const y = Number(local.slice(0, 4));
    const m = Number(local.slice(5, 7)) - 1;
    const d = Number(local.slice(8, 10));
    const H = Number(local.slice(11, 13));
    const M = Number(local.slice(14, 16));
    const S = Number(local.slice(17, 19));

    const desiredMs = Date.UTC(year, monthIdx, day, hh, mm, ss);
    const seenMs = Date.UTC(y, m, d, H, M, S);
    const delta = desiredMs - seenMs;

    if (delta === 0) break;
    guess = new Date(guess.getTime() + delta);
  }

  return guess.getTime();
}

function slugify(s) {
  return String(s || "")
    .toLowerCase()
    .trim()
    .replace(/['’]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "");
}

// ---------------- Dedupe ----------------
function dedupeCollected(items, lowerKey) {
  const map = new Map();

  for (const ev of items || []) {
    const artist = lowerKey(ev?.artist || "");
    const venue = lowerKey(ev?.venue || "");
    const city = lowerKey(ev?.city || "");
    const ts = Number(ev?.startTs || 0);

    if (!artist || !ts) continue;

    const key = `${artist}|${ts}|${city}|${venue}`;
    const prev = map.get(key);
    if (!prev) {
      map.set(key, ev);
      continue;
    }

    const prevUrl = String(prev?.url || "");
    const curUrl = String(ev?.url || "");
    const prevScore = (prev?.source === "tm" ? 2 : 1) + (prevUrl.startsWith("http") ? 1 : 0);
    const curScore = (ev?.source === "tm" ? 2 : 1) + (curUrl.startsWith("http") ? 1 : 0);

    if (curScore > prevScore) map.set(key, ev);
  }

  return Array.from(map.values());
}

// ---------------- Music-only matching ----------------
function insertSpacesInGluedWords(s) {
  return String(s || "")
    .replace(/([a-z])([A-Z])/g, "$1 $2")
    .replace(/\s{2,}/g, " ")
    .trim();
}

function normalizeArtistCandidate(s) {
  let t = insertSpacesInGluedWords(String(s || "").trim());
  const lk = t.toLowerCase().trim();
  if (lk === "slstafir") return "Sólstafir";
  return t;
}

function splitCandidatesFromText(title) {
  const t0 = String(title || "").trim();
  if (!t0) return [];

  const t = insertSpacesInGluedWords(t0);

  const parts = t
    .replace(/\s+/g, " ")
    .split(/(?:\s+\+\s+|,|\/|&| x | feat\.| ft\.| featuring | presents | w\/| with |\|\||–|-|:)/i)
    .map((x) => x.trim())
    .filter((x) => x.length >= 2);

  return [t, ...parts];
}

function pickBestArtistMatch(ev, lowerKey, tasteSet, ecosystemSet) {
  const primary0 = String(ev?.artist || "").trim();
  const primary = normalizeArtistCandidate(primary0);

  const atts = Array.isArray(ev?.attractions) ? ev.attractions : [];
  const candidates = [];

  if (primary) candidates.push(primary);

  for (const a of atts) {
    const s = normalizeArtistCandidate(String(a || "").trim());
    if (s) candidates.push(s);
  }

  for (const c of splitCandidatesFromText(primary)) candidates.push(normalizeArtistCandidate(c));

  const uniq = [];
  const seen = new Set();

  for (const c of candidates) {
    const s = String(c || "").trim();
    if (!s) continue;

    const k = lowerKey(s);
    if (!k) continue;

    if (seen.has(k)) continue;
    seen.add(k);

    uniq.push({ display: s, lower: k });
  }

  const aliasMap = new Map([["slstafir", "solstafir"]]);
  const applyAlias = (lower) => aliasMap.get(lower) || lower;

  for (const c of uniq) {
    const aliased = applyAlias(c.lower);
    if (tasteSet.has(aliased)) {
      return { ok: true, artistDisplay: c.display, artistLower: aliased, reason: "taste_match" };
    }
  }

  for (const c of uniq) {
    const aliased = applyAlias(c.lower);
    if (ecosystemSet.has(aliased)) {
      return {
        ok: true,
        artistDisplay: c.display,
        artistLower: aliased,
        reason: "ecosystem_match",
      };
    }
  }

  return { ok: false, reason: "no_match_to_taste_or_ecosystem" };
}

function attractionBoost(ev, lowerKey, tasteSet) {
  const atts = Array.isArray(ev?.attractions) ? ev.attractions : [];
  if (!atts.length) return 0;

  let hits = 0;
  for (const a of atts) {
    const lk = lowerKey(normalizeArtistCandidate(a));
    if (lk && tasteSet.has(lk)) hits += 1;
  }

  return Math.min(8, hits * 3);
}

// ---------------- Scoring tiers ----------------
function tierFromPlays(plays) {
  const p = Number(plays || 0);
  if (p >= 120) return "core";
  if (p >= 40) return "known";
  if (p >= 10) return "maybe";
  return "discovery";
}

function tierFromEcosystemMatch(match01) {
  const m = Number(match01 || 0);
  if (m >= 0.55) return "known";
  if (m >= 0.25) return "maybe";
  return "discovery";
}

function baseScoreFromTier(tier) {
  if (tier === "core") return 78;
  if (tier === "known") return 62;
  if (tier === "maybe") return 48;
  return 34;
}

// ---------------- Ticketmaster ----------------
async function ticketmasterEvents({ apiKey, countryCode, city, radiusKm, sizeRequested }) {
  const want = Math.max(1, Math.min(1000, Number(sizeRequested) || 1));
  const pageSize = Math.min(200, want);
  const nowIso = new Date().toISOString().replace(/\.\d{3}Z$/, "Z");

  const out = [];
  let page = 0;

  const maxPages = Math.min(10, Math.ceil(want / pageSize) + 2);

  while (out.length < want && page < maxPages) {
    const u = new URL("https://app.ticketmaster.com/discovery/v2/events.json");
    u.searchParams.set("apikey", apiKey);
    u.searchParams.set("countryCode", countryCode);
    u.searchParams.set("classificationName", "music");
    u.searchParams.set("sort", "date,asc");
    u.searchParams.set("size", String(pageSize));
    u.searchParams.set("page", String(page));
    u.searchParams.set("startDateTime", nowIso);

    const cityTrim = String(city || "").trim();
    if (cityTrim) {
      u.searchParams.set("city", cityTrim);
      if (radiusKm != null) {
        u.searchParams.set("radius", String(radiusKm));
        u.searchParams.set("unit", "km");
      }
    }

    const r = await fetch(u.toString(), { method: "GET" });
    const j = await r.json().catch(() => ({}));

    if (!r.ok) {
      const msg = j?.errors?.[0]?.detail || `Ticketmaster HTTP ${r.status}`;
      throw new Error(msg);
    }

    const items = j?._embedded?.events;
    if (!Array.isArray(items) || items.length === 0) break;

    for (const e of items) {
      if (out.length >= want) break;

      const id = String(e?.id || "").trim();
      if (!id) continue;

      const attractions = Array.isArray(e?._embedded?.attractions)
        ? e._embedded.attractions.map((a) => String(a?.name || "").trim()).filter(Boolean)
        : [];

      const artist = attractions[0] || String(e?.name || "").trim();

      const venueObj = Array.isArray(e?._embedded?.venues) ? e._embedded.venues[0] : null;
      const venue = String(venueObj?.name || "").trim();
      const cityName = String(venueObj?.city?.name || "").trim() || cityTrim || "";

      const dt = String(e?.dates?.start?.dateTime || "").trim();
      if (!dt) continue;

      const startDate = new Date(dt);
      if (Number.isNaN(startDate.getTime())) continue;

      const startTs = startDate.getTime();
      const startLocal = formatAmsterdamLocal(startDate);
      const url = String(e?.url || "").trim();

      out.push({
        id: `tm:${id}`,
        artist,
        attractions,
        city: cityName,
        venue: venue || "",
        startTs,
        startLocal,
        url,
      });
    }

    page += 1;
    const pageInfo = j?.page;
    if (pageInfo && Number.isFinite(pageInfo.totalPages) && page >= pageInfo.totalPages) break;
  }

  return out;
}

// ---------------- MetalAgenda (city pages) ----------------
function normalizeMAUrl(u) {
  return String(u || "").trim().replace(/\/+$/, "");
}

function isWhitelistedMAVenueUrl(url) {
  const u = normalizeMAUrl(url);
  if (!u) return false;

  const whitelist = new Set([
    "https://www.metalagenda.nl/venues/paradiso",
    "https://www.metalagenda.nl/venues/melkweg",
    "https://www.metalagenda.nl/venues/zonnehuis",
    "https://www.metalagenda.nl/venues/tolhuistuin",
