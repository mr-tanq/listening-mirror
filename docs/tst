export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // --- CORS ---
    const origin = request.headers.get("Origin") || "";
    const allowed = new Set([
      "https://mr-tanq.github.io",
      "http://localhost:5173",
      "http://localhost:4173",
      "http://localhost:3000",
    ]);

    const allowOrigin = allowed.has(origin) ? origin : "https://mr-tanq.github.io";
    const corsHeaders = {
      "access-control-allow-origin": allowOrigin,
      "access-control-allow-methods": "GET,POST,OPTIONS",
      "access-control-allow-headers": "content-type, authorization",
      "access-control-max-age": "86400",
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { status: 204, headers: corsHeaders });
    }

    const jsonRes = (obj, status = 200) =>
      new Response(JSON.stringify(obj, null, 2), {
        status,
        headers: {
          "content-type": "application/json; charset=utf-8",
          ...corsHeaders,
        },
      });

    const lowerKey = (s) => String(s || "").trim().toLowerCase();

    const clampInt = (v, a, b, fallback) => {
      const n = Number(v);
      if (!Number.isFinite(n)) return fallback;
      return Math.max(a, Math.min(b, Math.trunc(n)));
    };

    try {
      if (url.pathname === "/health") {
        return jsonRes({ ok: true, service: "live", time: new Date().toISOString() });
      }

      if (url.pathname === "/econcerts") {
        return await handleEconcerts(request, env, ctx, jsonRes, lowerKey, clampInt);
      }

      return jsonRes({ ok: false, error: "not_found", path: url.pathname }, 404);
    } catch (err) {
      return jsonRes(
        {
          ok: false,
          error: "internal_error",
          message: String(err?.message || err),
        },
        500
      );
    }
  },
};

async function handleEconcerts(request, env, ctx, jsonRes, lowerKey, clampInt) {
  const url = new URL(request.url);

  const TMASTER_API_KEY = String(env.TMASTER_API_KEY || "").trim();
  const LASTFM_API_KEY = String(env.LASTFM_API_KEY || "").trim();
  const LASTFM_USER = String(env.LASTFM_USER || "").trim();

  const size = clampInt(url.searchParams.get("size"), 1, 1000, 50);
  const radiusKm = clampInt(url.searchParams.get("radiusKm"), 1, 500, 30);
  const scoreMin = clampInt(url.searchParams.get("scoreMin"), 0, 100, 0);

  // Forced
  const tasteArtists = 1000;

  const cityRaw = String(url.searchParams.get("city") || "").trim();
  const city = cityRaw;

  const countryCode = String(url.searchParams.get("countryCode") || "NL")
    .trim()
    .toUpperCase();

  const sources = parseSources(String(url.searchParams.get("sources") || "tm,ma,tv,ra"));
  const debug = String(url.searchParams.get("debug") || "").trim() === "1";

  if (!LASTFM_API_KEY) {
    return jsonRes({ ok: false, error: "missing_env", message: "Missing LASTFM_API_KEY" }, 500);
  }
  if (!LASTFM_USER) {
    return jsonRes({ ok: false, error: "missing_env", message: "Missing LASTFM_USER" }, 500);
  }
  if (sources.includes("tm") && !TMASTER_API_KEY) {
    return jsonRes({ ok: false, error: "missing_env", message: "Missing TMASTER_API_KEY" }, 500);
  }

  // ---------------- Taste ----------------
  const taste = await lastfmTopArtistsOverall(LASTFM_API_KEY, LASTFM_USER, tasteArtists);
  const tasteMap = new Map(taste.map((x) => [lowerKey(x.name), x.playcount]));
  const tasteSet = new Set(taste.map((x) => lowerKey(x.name)));

  // ---------------- Ecosystem (cached) ----------------
  const SIMILAR_SEEDS = 8;
  const SIMILAR_LIMIT = 50;

  const seeds = taste
    .slice(0, SIMILAR_SEEDS)
    .map((x) => x.name)
    .filter(Boolean);

  const ecoBuild = await buildEcosystemCached(LASTFM_API_KEY, seeds, SIMILAR_LIMIT, lowerKey);
  const ecosystemSet = ecoBuild.set;
  const ecosystemWeight = ecoBuild.weightMap;

  // ---------------- Collect events ----------------
  const collected = [];

  let tmEventsParsed = null;
  if (sources.includes("tm")) {
    const tmEvents = await ticketmasterEvents({
      apiKey: TMASTER_API_KEY,
      countryCode,
      city: city || "",
      radiusKm: city ? radiusKm : null,
      sizeRequested: size,
    });

    tmEventsParsed = tmEvents.length;
    for (const ev of tmEvents) collected.push({ ...ev, source: "tm" });
  }

  let maPagesFetched = 0;
  let maEventsParsed = 0;
  let maFetchMeta = [];
  if (sources.includes("ma")) {
    const maRes = await metalAgendaEventsByCities({
      maxEvents: size,
      countryCode,
      city: city || "",
      debug,
    });
    maPagesFetched = maRes.pagesFetched;
    maEventsParsed = maRes.eventsParsed;
    maFetchMeta = maRes.fetchMeta || [];
    for (const ev of maRes.events) collected.push({ ...ev, source: "ma" });
  }

  let tvPagesFetched = 0;
  let tvEventsParsed = 0;
  if (sources.includes("tv")) {
    const tvRes = await tivoliAgendaEvents({
      maxEvents: size,
      countryCode,
      maxPages: 10,
      hydrateLimit: 14,
    });
    tvPagesFetched = tvRes.pagesFetched;
    tvEventsParsed = tvRes.eventsParsed;
    for (const ev of tvRes.events) collected.push({ ...ev, source: "tv" });
  }

  // NEW: Reggae Agenda
  let raPagesFetched = 0;
  let raEventsParsed = 0;
  if (sources.includes("ra")) {
    const raRes = await reggaeAgendaEvents({
      maxEvents: size,
      countryCode,
      debug,
    });
    raPagesFetched = raRes.pagesFetched;
    raEventsParsed = raRes.eventsParsed;
    for (const ev of raRes.events) collected.push({ ...ev, source: "ra" });
  }

  const deduped = dedupeCollected(collected, lowerKey);

  // ---------------- Music-only filter + scoring ----------------
  const dropped = [];
  const eventsScored = [];

  for (const ev of deduped) {
    const pick = pickBestArtistMatch(ev, lowerKey, tasteSet, ecosystemSet);

    if (!pick.ok) {
      if (debug && dropped.length < 300) {
        dropped.push({
          id: ev.id,
          source: ev.source || "",
          title: ev.artist || "",
          url: ev.url || "",
          reason: pick.reason,
        });
      }
      continue;
    }

    const artistLower = pick.artistLower;
    const plays = tasteMap.get(artistLower) || 0;
    const inTaste = tasteSet.has(artistLower);
    const ecoMatch = ecosystemWeight.get(artistLower) || 0;

    const tier = inTaste ? tierFromPlays(plays) : tierFromEcosystemMatch(ecoMatch);

    let score = baseScoreFromTier(tier);
    score = Math.max(0, Math.min(100, Math.round(score + attractionBoost(ev, lowerKey, tasteSet))));

    const level = score >= 80 ? "strong" : score >= 65 ? "good" : score >= 50 ? "ok" : "weak";

    if (score >= scoreMin) {
      // Artist display normalization (case fix)
      const display = normalizeDisplayArtist(pick.artistDisplay);

      eventsScored.push({
        id: ev.id,
        artist: display,
        attractions: ev.attractions,
        city: ev.city,
        venue: ev.venue,
        start: ev.startLocal,
        url: ev.url,
        plays,
        tier,
        score,
        level,
        startTs: ev.startTs,
        source: ev.source || "tm",
        star: false,
      });
    }
  }

  eventsScored.sort((a, b) => b.score - a.score || a.startTs - b.startTs);
  const finalEvents = eventsScored.slice(0, size);

  return jsonRes({
    ok: true,
    meta: {
      sizeRequested: size,
      radiusKm: city ? radiusKm : null,
      scoreMin,
      tasteArtists,
      eventsFetched: deduped.length,
      eventsReturned: finalEvents.length,
      city: city || null,
      countryCode,
      sources,
      mode: city ? "near_city" : "nl_wide",
      tmEventsParsed,
      maPagesFetched: sources.includes("ma") ? maPagesFetched : null,
      maEventsParsed: sources.includes("ma") ? maEventsParsed : null,
      maFetch: debug ? maFetchMeta : undefined,
      tvPagesFetched: sources.includes("tv") ? tvPagesFetched : null,
      tvEventsParsed: sources.includes("tv") ? tvEventsParsed : null,
      raPagesFetched: sources.includes("ra") ? raPagesFetched : null,
      raEventsParsed: sources.includes("ra") ? raEventsParsed : null,
      model: "music_only_ecosystem_no_distance_no_time",
      ecosystem: {
        tasteCount: taste.length,
        ecosystemCount: ecosystemSet.size,
        similarSeedsUsed: seeds.length,
      },
      droppedCount: debug ? dropped.length : undefined,
    },
    events: finalEvents,
    dropped: debug ? dropped : undefined,
  });
}

function parseSources(raw) {
  const s = String(raw || "tm")
    .split(",")
    .map((x) => x.trim().toLowerCase())
    .filter(Boolean);

  const out = [];
  for (const x of s) {
    if (x === "tm" || x === "ticketmaster") out.push("tm");
    if (x === "ma" || x === "metalagenda") out.push("ma");
    if (x === "tv" || x === "tivoli" || x === "tivolivredenburg") out.push("tv");
    if (x === "ra" || x === "reggae" || x === "reggaeagenda" || x === "reggae-agenda")
      out.push("ra");
  }
  return out.length ? Array.from(new Set(out)) : ["tm"];
}

// ---------------- Display name casing ----------------
function isAllLower(s) {
  const t = String(s || "").trim();
  if (!t) return false;
  return t === t.toLowerCase() && t !== t.toUpperCase();
}
function isAllUpper(s) {
  const t = String(s || "").trim();
  if (!t) return false;
  return t === t.toUpperCase() && t !== t.toLowerCase();
}
function titleCaseWord(w) {
  const t = String(w || "");
  if (!t) return t;
  // keep short acronyms upper (e.g., DJ, MC, UK)
  const lettersOnly = t.replace(/[^a-zA-Z]/g, "");
  if (lettersOnly.length > 0 && lettersOnly.length <= 3 && t === t.toUpperCase()) return t;
  // normal
  return t.charAt(0).toUpperCase() + t.slice(1).toLowerCase();
}
function toTitleCasePreserveSeparators(s) {
  const t = String(s || "").trim();
  // split by spaces but keep punctuation inside tokens
  return t
    .split(/\s+/g)
    .map((tok) => {
      // handle hyphenated: "high-parasite"
      if (tok.includes("-")) {
        return tok
          .split("-")
          .map((x) => titleCaseWord(x))
          .join("-");
      }
      return titleCaseWord(tok);
    })
    .join(" ");
}
function normalizeDisplayArtist(name) {
  const t = String(name || "").trim();
  if (!t) return t;
  if (isAllLower(t) || isAllUpper(t)) return toTitleCasePreserveSeparators(t);
  return t;
}

// ---------------- Last.fm ----------------
async function lastfmTopArtistsOverall(apiKey, user, limit) {
  const u = new URL("https://ws.audioscrobbler.com/2.0/");
  u.searchParams.set("method", "user.gettopartists");
  u.searchParams.set("user", user);
  u.searchParams.set("api_key", apiKey);
  u.searchParams.set("format", "json");
  u.searchParams.set("limit", String(limit));
  u.searchParams.set("period", "overall");

  const r = await fetch(u.toString(), { method: "GET" });
  const j = await r.json().catch(() => ({}));

  if (!r.ok) throw new Error(`Last.fm HTTP ${r.status}`);
  if (j && j.error) throw new Error(`Last.fm: ${j.message || "error"}`);

  const arr = j?.topartists?.artist;
  if (!Array.isArray(arr)) return [];

  const out = [];
  for (const a of arr) {
    const name = String(a?.name || "").trim();
    const playcount = Number(a?.playcount || 0);
    if (!name) continue;
    out.push({ name, playcount: Number.isFinite(playcount) ? playcount : 0 });
  }

  out.sort((a, b) => b.playcount - a.playcount);
  return out;
}

async function lastfmGetSimilar(apiKey, artistName, limit) {
  const u = new URL("https://ws.audioscrobbler.com/2.0/");
  u.searchParams.set("method", "artist.getsimilar");
  u.searchParams.set("artist", artistName);
  u.searchParams.set("api_key", apiKey);
  u.searchParams.set("format", "json");
  u.searchParams.set("limit", String(limit || 50));
  u.searchParams.set("autocorrect", "1");

  const r = await fetch(u.toString(), { method: "GET" });
  const j = await r.json().catch(() => ({}));

  if (!r.ok) throw new Error(`Last.fm similar HTTP ${r.status}`);
  if (j && j.error) throw new Error(`Last.fm similar: ${j.message || "error"}`);

  const arr = j?.similarartists?.artist;
  if (!Array.isArray(arr)) return [];

  const out = [];
  for (const a of arr) {
    const name = String(a?.name || "").trim();
    const match = Number(a?.match || a?.similarity || 0);
    if (!name) continue;
    out.push({ name, match: Number.isFinite(match) ? match : 0 });
  }
  return out;
}

async function buildEcosystemCached(apiKey, seeds, limit, lowerKey) {
  const set = new Set();
  const weightMap = new Map();

  const seedList = Array.isArray(seeds) ? seeds.slice(0, 20) : [];
  for (const s of seedList) {
    const lk = lowerKey(s);
    if (!lk) continue;
    set.add(lk);
    weightMap.set(lk, Math.max(weightMap.get(lk) || 0, 1));
  }

  for (const seed of seedList) {
    const cached = await cacheGetSimilar(apiKey, seed, limit).catch(() => null);
    const arr = Array.isArray(cached) ? cached : [];

    for (const it of arr) {
      const name = String(it?.name || "").trim();
      const lk = lowerKey(name);
      if (!lk) continue;

      set.add(lk);
      const m = Number(it?.match || 0);
      const prev = weightMap.get(lk) || 0;
      if (m > prev) weightMap.set(lk, m);
    }
  }

  return { set, weightMap };
}

async function cacheGetSimilar(apiKey, seed, limit) {
  const key = `lm:lastfm:similar:v2:${encodeURIComponent(
    String(seed || "").trim().toLowerCase()
  )}:L${Number(limit || 50)}`;

  const cache = caches.default;
  const req = new Request("https://cache.local/" + key, { method: "GET" });

  const hit = await cache.match(req);
  if (hit) {
    const j = await hit.json().catch(() => null);
    if (Array.isArray(j)) return j;
  }

  const fresh = await lastfmGetSimilar(apiKey, seed, limit);
  const res = new Response(JSON.stringify(fresh), {
    headers: {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "public, max-age=604800",
    },
  });

  cache.put(req, res.clone()).catch(() => {});
  return fresh;
}

