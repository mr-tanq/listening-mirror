{
  "name": "econcerts",
  "main": "src/worker.js",
  "compatibility_date": "2026-03-14",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "econcerts-db",
      "database_id": "9af28707-ff7e-43a5-9ff2-a713f1f46aaf"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}