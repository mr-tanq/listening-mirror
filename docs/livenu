function cityVariants(city) {
  const c = String(city || "").trim();
  const low = c.toLowerCase();
  const dash = low.replace(/\s+/g, "-");

  if (low === "amsterdam") return ["Amsterdam", "amsterdam"];
  if (low === "utrecht") return ["utrecht", "Utrecht"];
  if (low === "rotterdam") return ["Rotterdam", "rotterdam"];
  if (low === "haarlem") return ["Haarlem", "haarlem"];
  if (low === "nijmegen") return ["Nijmegen", "nijmegen"];
  if (low === "eindhoven") return ["Eindhoven", "eindhoven"];
  if (low === "tilburg") return ["Tilburg", "tilburg"];
  if (low === "maastricht") return ["Maastricht", "maastricht"];
  if (low === "zoetermeer") return ["Zoetermeer", "zoetermeer"];
  if (low === "leeuwarden") return ["Leeuwarden", "leeuwarden"];
  if (low === "hengelo") return ["Hengelo", "hengelo"];
  if (low === "groningen") return ["Groningen", "groningen"];
  if (low === "den haag" || low === "den-haag")
    return ["Den-Haag", "den-haag", "Den%20Haag", "den%20haag"];

  return [c, low, dash];
}

async function metalAgendaEventsByCities({ maxEvents, countryCode, debug }) {
  if (String(countryCode || "").toUpperCase() !== "NL") {
    return { pagesFetched: 0, eventsParsed: 0, events: [], fetchMeta: [] };
  }

  const want = Math.max(1, Math.min(1000, Number(maxEvents) || 50));
  const cities = [
    "Amsterdam",
    "Utrecht",
    "Rotterdam",
    "Den Haag",
    "Haarlem",
    "Nijmegen",
    "Eindhoven",
    "Tilburg",
    "Maastricht",
    "Zoetermeer",
    "Leeuwarden",
    "Hengelo",
  ];

  const events = [];
  let pagesFetched = 0;
  let eventsParsed = 0;

  const fetchMeta = [];
  const concurrency = 4;
  let idx = 0;

  const runner = async () => {
    while (idx < cities.length && events.length < want) {
      const city = cities[idx++];
      const vars = cityVariants(city);

      let best = null;

      for (const v of vars) {
        const pageUrl = `https://www.metalagenda.nl/p/${v}`;

        const res = await fetchTextWithStatus(pageUrl).catch(() => ({
          ok: false,
          status: 0,
          url: pageUrl,
          text: "",
        }));

        pagesFetched += 1;

        const bytes = (res.text || "").length;
        const looksOk =
          res.ok &&
          bytes > 2000 &&
          (res.text.includes("/venues/") ||
            res.text.includes("Bands:") ||
            res.text.includes("metalagenda"));

        if (debug) {
          fetchMeta.push({
            city,
            tried: pageUrl,
            status: res.status,
            finalUrl: res.url,
            bytes,
            looksOk,
          });
        }

        if (looksOk) {
          best = { url: pageUrl, html: res.text };
          break;
        }
      }

      if (!best) continue;

      const parsed = parseMetalAgendaCityHtml(best.url, city, best.html);
      eventsParsed += parsed.length;

      for (const ev of parsed) {
        if (!isWhitelistedMAVenueUrl(ev.url)) continue;
        events.push(ev);
        if (events.length >= want) break;
      }
    }
  };

  await Promise.all(Array.from({ length: concurrency }, () => runner()));

  const cutoff = Date.now() - 12 * 60 * 60 * 1000;
  const upcoming = events.filter((e) => Number(e?.startTs) >= cutoff);
  upcoming.sort((a, b) => a.startTs - b.startTs);

  return {
    pagesFetched,
    eventsParsed,
    events: upcoming.slice(0, want),
    fetchMeta: debug ? fetchMeta.slice(0, 200) : [],
  };
}

function parseMetalAgendaCityHtml(pageUrl, cityName, html) {
  const monthMap = {
    januari: 0,
    februari: 1,
    maart: 2,
    april: 3,
    mei: 4,
    juni: 5,
    juli: 6,
    augustus: 7,
    september: 8,
    oktober: 9,
    november: 10,
    december: 11,
  };

  const out = [];
  const src = String(html || "");

  const re =
    /\b(\d{1,2})\s+(januari|februari|maart|april|mei|juni|juli|augustus|september|oktober|november|december)\s+(\d{4})\b[\s\S]{0,1200}?href="(https:\/\/www\.metalagenda\.nl\/venues\/[^"]+)"[\s\S]{0,1200}?(?:Bands:\s*([^<\n]{2,500}))?/gi;

  let m;
  while ((m = re.exec(src)) && out.length < 4000) {
    const day = Number(m[1]);
    const monthName = String(m[2] || "").toLowerCase();
    const year = Number(m[3]);
    const venueUrl = String(m[4] || "").trim();
    const bandsRaw = String(m[5] || "").trim();

    const monthIdx = monthMap[monthName];
    if (monthIdx == null) continue;
    if (!venueUrl) continue;

    let bands = [];
    if (bandsRaw) {
      bands = decodeHtmlEntities(bandsRaw)
        .split("|")
        .map((x) => insertSpacesInGluedWords(x).trim())
        .filter(Boolean);
    }

    const headliner = (bands[0] || "").trim();
    if (!headliner) continue;

    let hh = 20,
      mm = 0;
    const mt = String(m[0] || "").match(/\b([01]\d|2[0-3]):([0-5]\d)\b/);
    if (mt) {
      hh = Number(mt[1]);
      mm = Number(mt[2]);
    }

    const startTs = epochFromAmsterdamLocal(year, monthIdx, day, hh, mm, 0);
    const startLocal = formatAmsterdamLocal(new Date(startTs));

    out.push({
      id: `ma:${slugify(cityName)}:${year}-${String(monthIdx + 1).padStart(2, "0")}-${String(
        day
      ).padStart(2, "0")}:${slugify(headliner)}:${slugify(cityName)}`,
      artist: headliner,
      attractions: bands.length ? bands : [headliner],
      city: cityName || "",
      venue: "",
      startTs,
      startLocal,
      url: venueUrl,
    });
  }

  return out;
}

// ---------------- TivoliVredenburg ----------------
async function tivoliAgendaEvents({ maxEvents, countryCode, maxPages = 10, hydrateLimit = 14 }) {
  if (String(countryCode || "").toUpperCase() !== "NL") {
    return { pagesFetched: 0, eventsParsed: 0, events: [] };
  }

  const want = Math.max(1, Math.min(1000, Number(maxEvents) || 50));
  const events = [];

  let pagesFetched = 0;
  let eventsParsed = 0;

  const pages = Math.max(1, Math.min(20, Number(maxPages) || 10));

  for (let page = 1; page <= pages && events.length < want; page++) {
    const pageUrl = `https://www.tivolivredenburg.nl/agenda/page/${page}/`;

    const r = await fetchTextWithStatus(pageUrl).catch(() => ({ ok: false, text: "" }));
    pagesFetched += 1;

    if (!r.ok || !r.text) continue;

    const parsed = parseTivoliAgendaHtml(r.text);
    eventsParsed += parsed.length;

    for (const ev of parsed) {
      if (events.length >= want) break;
      events.push(ev);
    }
  }

  const cutoff = Date.now() - 12 * 60 * 60 * 1000;
  const upcoming = events.filter((e) => Number(e?.startTs) >= cutoff);

  const seen = new Set();
  const uniq = [];

  for (const e of upcoming) {
    const k = String(e.url || "");
    if (!k) continue;
    if (seen.has(k)) continue;
    seen.add(k);
    uniq.push(e);
  }

  const toHydrate = uniq.slice(0, Math.max(0, Math.min(50, Number(hydrateLimit) || 0)));
  const rest = uniq.slice(toHydrate.length);

  const hydratedHead = await mapLimit(toHydrate, 6, async (ev) => {
    const full = await tivoliHydrateEvent(ev).catch(() => null);
    return full || ev;
  });

  const hydrated = hydratedHead.concat(rest);
  hydrated.sort((a, b) => a.startTs - b.startTs);

  return {
    pagesFetched,
    eventsParsed,
    events: hydrated.slice(0, want),
  };
}

function parseTivoliAgendaHtml(html) {
  const out = [];

  const monthMap = {
    jan: 0,
    "jan.": 0,
    feb: 1,
    "feb.": 1,
    mrt: 2,
    "mrt.": 2,
    apr: 3,
    "apr.": 3,
    mei: 4,
    jun: 5,
    "jun.": 5,
    jul: 6,
    "jul.": 6,
    aug: 7,
    "aug.": 7,
    sep: 8,
    "sep.": 8,
    okt: 9,
    "okt.": 9,
    nov: 10,
    "nov.": 10,
    dec: 11,
    "dec.": 11,
  };

  const re =
    /\b(ma|di|wo|do|vr|za|zo)\s+(\d{1,2})\s+([a-z]{3}.?)\s+(\d{4})[\s\S]{0,900}?href="(https:\/\/www\.tivolivredenburg\.nl\/agenda\/[^"]+)"[^>]*>\s*([^<]{2,180})\s*<\/a>/gi;

  let m;
  while ((m = re.exec(String(html))) && out.length < 5000) {
    const day = Number(m[2]);
    const monRaw = String(m[3] || "").toLowerCase();
    const year = Number(m[4]);
    const url = String(m[5] || "").trim();

    let title = String(m[6] || "").trim();
    title = decodeHtmlEntities(title).replace(/\s+/g, " ").trim();

    const monthIdx = monthMap[monRaw];
    if (monthIdx == null) continue;
    if (!title || !url) continue;

    const startTs = epochFromAmsterdamLocal(year, monthIdx, day, 20, 0, 0);
    const startLocal = formatAmsterdamLocal(new Date(startTs));

    out.push({
      id: `tv:${slugify(title)}:${year}-${String(monthIdx + 1).padStart(2, "0")}-${String(
        day
      ).padStart(2, "0")}`,
      artist: title,
      attractions: [title],
      city: "Utrecht",
      venue: "TivoliVredenburg",
      startTs,
      startLocal,
      url,
    });
  }

  return out;
}

async function tivoliHydrateEvent(ev) {
  const url = String(ev?.url || "");
  if (!url.startsWith("https://www.tivolivredenburg.nl/agenda/")) return ev;

  const r = await fetchTextWithStatus(url).catch(() => ({ ok: false, text: "" }));
  if (!r.ok || !r.text) return ev;

  const html = r.text;

  const jsonLdBlocks = [];
  const reLd = /<script[^>]+type=["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi;

  let m;
  while ((m = reLd.exec(html))) {
    const raw = String(m[1] || "").trim();
    if (raw) jsonLdBlocks.push(raw);
  }

  let startTs = ev.startTs;
  let startLocal = ev.startLocal;

  for (const blk of jsonLdBlocks) {
    const txt = blk.replace(/\n/g, " ").trim();
    const sm = txt.match(/"startDate"\s*:\s*"([^"]+)"/i);
    if (sm) {
      const iso = String(sm[1] || "").trim();
      const d = new Date(iso);
      if (!Number.isNaN(d.getTime())) {
        startTs = d.getTime();
        startLocal = formatAmsterdamLocal(new Date(startTs));
        break;
      }
    }
  }

  if (startTs === ev.startTs) {
    const sm2 = html.match(/datetime=["']([^"']+)["']/i);
    if (sm2) {
      const iso = String(sm2[1] || "").trim();
      const d = new Date(iso);
      if (!Number.isNaN(d.getTime())) {
        startTs = d.getTime();
        startLocal = formatAmsterdamLocal(new Date(startTs));
      }
    }
  }

  let title = ev.artist;
  const h1m = html.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i);
  if (h1m) {
    const t = decodeHtmlEntities(h1m[1])
      .replace(/<[^>]+>/g, " ")
      .replace(/\s+/g, " ")
      .trim();
    if (t && t.length >= 2) title = t;
  }

  let zaal = "";
  const zaalM = html.match(
    /\b(Zaal|Hall|Room)\b[\s\S]{0,80}?\b(Ronda|Pandora|Cloud Nine|Hertz|Grote Zaal|Kleine Zaal)\b/i
  );
  if (zaalM) zaal = String(zaalM[2] || "").trim();

  return {
    ...ev,
    artist: title,
    attractions: [title],
    venue: zaal ? `TivoliVredenburg (${zaal})` : "TivoliVredenburg",
    startTs,
    startLocal,
  };
}

async function mapLimit(arr, limit, fn) {
  const out = new Array(arr.length);
  let i = 0;

  const workers = Array.from({ length: Math.max(1, limit) }, async () => {
    while (i < arr.length) {
      const idx = i++;
      out[idx] = await fn(arr[idx], idx);
    }
  });

  await Promise.all(workers);
  return out;
}